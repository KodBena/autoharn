#!/usr/bin/env python3
"""stamp-run — the umbrella-CLI entry point for `autoharn stamp-run -- <command...>` (work item
human-countersign-stamp-path, ledger rows 619/667/672). An autoharn-repo-specific operator verb
(same footing as `dispatch`/`migrate`/`fixture-sweep`: it mints a stamp for THIS repo's OWN
deployment.json by default — a fresh scaffolded world gets its own stamp-run verb only if a
future scaffold-migration pass adds it, not attempted here).

ALL THE ACTUAL LOGIC (deployment/secret resolution, stamp minting via tools/stamp_mint.py, the
os.execvpe of the wrapped command) lives in tools/stamp_run.py — see that module's own
docstring. This file's only jobs, mirroring libexec/autoharn/dispatch's own shape (the
established precedent for a Python-native, non-.tmpl-delegating repo-root verb): the
fixture-sandbox check, then pass argv through unmodified.

Lazy imports are banned (CLAUDE.md, 2026-07-02): everything below imports at module load.
"""
from __future__ import annotations

import sys
from pathlib import Path

# Two levels up from libexec/autoharn/ to the repo root — same climb every relocated verb uses.
_REPO_ROOT = Path(__file__).resolve().parent.parent.parent
sys.path.insert(0, str(_REPO_ROOT / "filing"))
import fixture_sandbox  # noqa: E402  (filing/fixture_sandbox.py — the Python-side fixture-sandbox check)
sys.path.insert(0, str(_REPO_ROOT / "tools"))
import stamp_run  # noqa: E402  (tools/stamp_run.py — the actual verb logic)


def main(argv: list[str]) -> int:
    # EXEMPTION, narrow and precedented (see ./autoharn's own _fixture_sandbox_gate comment and
    # libexec/autoharn/dispatch's identical exemption): a bare --help/-h/no-args never touches a
    # deployment or execs anything — tools/stamp_run.main prints its own usage and returns, so
    # it is exempt from the marker check exactly like every other repo-root verb's --help.
    if argv not in ([], ["--help"], ["-h"], ["help"]):
        fixture_sandbox.check("libexec/autoharn/stamp-run " + " ".join(argv))
    return stamp_run.main(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
