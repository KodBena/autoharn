              f"informs (got {edge_type!r}).", file=sys.stderr)
        return 1
    # --supersedes VALIDATION (ledger item led-work-depends-supersedes), ported off legacy's own
    # three checks -- (i)/(ii) below read GET /rows/{id} (raw ledger by id) and a walk of
    # /rows/current for "already superseded"; DISCLOSED NARROWING versus legacy's raw-ledger
    # SQL -- see this file's own SCOPE comment near the top for the exact residual.
    if supersedes:
        try:
            target = bcc.get_json(cfg.base, f"/rows/{supersedes}")
        except bcc.BoundaryRefusal as e:
            if e.status == 404:
                print(f"led work depends: REFUSED -- --supersedes {supersedes} does not name "
                      f"any ledger row. NOTHING was written.", file=sys.stderr)
                return 1
            raise
        if target.get("kind") != "work_depends_on":
            print(f"led work depends: REFUSED -- --supersedes {supersedes} names a "
                  f"'{target.get('kind')}' row, not a work_depends_on row. NOTHING was written.",
                  file=sys.stderr)
            return 1
        current_rows = bcc.get_all_rows(cfg.base, "/rows/current", cursor="after_id")
        superseder = next((r for r in current_rows if str(r.get("supersedes")) == str(supersedes)), None)
        if superseder is not None:
            print(f"led work depends: REFUSED -- --supersedes {supersedes} is already "
                  f"superseded (by row {superseder['id']}). NOTHING was written.", file=sys.stderr)
            return 1
    if not edge_type:
        print(f"led work depends: recorded as informs (advisory only -- never enforced at "
              f"close or claim); if {on} must be finished before {slug} may close, use "
              f"--type blocks-close; if {on} must be CLOSED before {slug} may be CLAIMED, use "
              f"--type blocks-start (s39).", file=sys.stderr)
    actor = _resolve_actor(cfg)
    payload: dict = {"kind": "work_depends_on", "work_slug": slug, "work_depends_on": on,
                      "statement": f"work_depends_on: {slug} depends on {on}"}
    if edge_type:
        payload["edge_type"] = edge_type
    if supersedes:
        payload["supersedes"] = int(supersedes)
    if actor is not None:
        payload["actor"] = actor
    return bcc.write_and_report(cfg.base, "ledger", payload)


def _slug_claimant(cfg: bcc.ServedConfig, slug: str):
    """Reads GET /views/work_item_current for <slug>'s own `claimant` field -- the led-side
    claim-before-close gate's data source, ported off legacy's own raw
    `SELECT EXISTS(... kind='work_claimed' AND work_slug=...)` scan -- a disclosed
    representation change (reads the CURRENT view rather than the raw table), same true/false
    answer for the ordinary case (see this file's own SCOPE comment)."""
    rows = bcc.get_all_rows(cfg.base, "/views/work_item_current", cursor="after_slug")
    for r in rows:
        if r.get("slug") == slug:
            return r.get("claimant")
    return None


def _commit_witness_reachability_violation(world_root: Path, sha: str) -> list[str] | None:
    """close-witness-reachability-check (ledger rows 402/336-family): `led work close --witness
    commit:<sha>` -- in ANY of its constructors (`--review-bookkeeping`'s mandatory commit
    witness, or a plain `--witness commit:<sha>` riding along on `--review-witness`/
    `--review-deferred`/a `shipped` close alike) -- must cite a sha that is an ancestor of (or
    equal to) the CURRENT HEAD of THIS DEPLOYMENT'S OWN repository, resolved from `world_root`
    (`_world_root()`: the directory the deployment record itself was found in), NEVER the
    caller's cwd. Mechanizes the twice-witnessed defect this item exists to close: row 302's
    coordinator error (a close chained onto an unverified commit result) and this batch's own
    finding -- a close run from a WORKTREE citing a commit unreachable from the world's own
    main; a worktree's cwd can see commits main cannot, so cwd is the attack surface here, never
    the anchor. The repo the deployment record names is the one truth this check is anchored to
    (ADR-0012 P1: `_world_root()` is already the ONE home for that resolution, reused here rather
    than a second hand-derived notion of "the repo").

    TWO checks, in order (mirrors `_review_witness_violation`'s own two-checks-in-order shape
    immediately below): (1) EXISTENCE -- `git cat-file -e <sha>^{commit}` (a nonexistent sha is a
    distinct, more legible refusal than folding it into the ancestor check's own plumbing exit
    code); (2) REACHABILITY -- `git merge-base --is-ancestor <sha> HEAD` (ancestor-of-or-equal-to
    HEAD is exactly `--is-ancestor`'s own contract, HEAD included). Both invoked with `-C
    world_root` only -- this process's own cwd never enters either git invocation.

    Returns REFUSED teach-text (stderr lines) naming the sha, the resolved repo root, and that
    the fix is completing the merge first -- this check never auto-passes -- or None if the sha
    is a reachable ancestor. A witness that does not match `_COMMIT_WITNESS_RE` (prose, a bare
    ref, `row:<id>`, `artifact:<hash>`, ...) never reaches this function at all -- untouched by
    this check, exactly as the item's own spec states; see `cmd_work_close`'s own call site for
    the shape gate."""
    r = subprocess.run(["git", "-C", str(world_root), "cat-file", "-e", f"{sha}^{{commit}}"],
                        capture_output=True)
    if r.returncode != 0:
        return [f"led work close: REFUSED -- --witness commit '{sha}' failed the COMMIT-"
                f"EXISTENCE check against {world_root}.",
                f"  Cite a real, already-committed sha (git -C {world_root} log). NOTHING was "
                f"written."]
    r = subprocess.run(["git", "-C", str(world_root), "merge-base", "--is-ancestor", sha, "HEAD"],
                        capture_output=True)
    if r.returncode != 0:
        head_r = subprocess.run(["git", "-C", str(world_root), "rev-parse", "HEAD"],
                                 capture_output=True, text=True)
        head = head_r.stdout.strip() if head_r.returncode == 0 else "<unresolvable>"
        return [f"led work close: REFUSED -- --witness commit:{sha} is not reachable from (not "
                f"an ancestor of, and not equal to) the current HEAD ({head}) of the repo rooted "
                f"at {world_root} -- resolved from THIS DEPLOYMENT'S OWN repository record "
                f"(_world_root(), never this process's cwd; a worktree's cwd is the attack "
                f"surface this check exists to close).",
                f"  Fix: finish merging {sha} into {world_root}'s HEAD first, then close -- this "
                f"check never auto-passes. NOTHING was written."]
    return None


# led-work-close-contract-flags (B2, row 1200/1025/1008): the ONE recognized flag vocabulary
# for `led work close` (and, unchanged, forwarded through to it by `led work reclose` below --
# ADR-0012 P1, one home for "what does a close-contract argv look like" rather than a second
# hand-copy of this same list drifting in the sub-verb that composes with it).
_WORK_CLOSE_VALUE_FLAGS = ("--witness", "--review-witness", "--review-annulled", "--supersedes")
_WORK_CLOSE_BOOL_FLAGS = ("--review-deferred", "--review-bookkeeping", "--strict")


def cmd_work_close(cfg: bcc.ServedConfig, argv: list[str]) -> int:
    witness = review_witness = review_annulled = None
    review_deferred = review_bookkeeping = strict = False
    supersedes = None
    args: list[str] = []
    it = iter(argv)
    for tok in it:
        if tok in _WORK_CLOSE_VALUE_FLAGS:
            val = next(it, None)
            if tok == "--witness":
                witness = val
            elif tok == "--review-witness":
                review_witness = val
            elif tok == "--review-annulled":
                review_annulled = val
            else:  # --supersedes
                supersedes = val
        elif tok in _WORK_CLOSE_BOOL_FLAGS:
            if tok == "--review-deferred":
                review_deferred = True
            elif tok == "--review-bookkeeping":
                review_bookkeeping = True
            else:  # --strict
                strict = True
        elif tok.startswith("--"):
            print(f"led work close: REFUSED -- unrecognized flag '{tok}'.", file=sys.stderr)
            print("  led work close <slug> <resolution> accepts only: --witness <ref>,", file=sys.stderr)
            print("  --review-witness <ref>, --review-deferred, --review-bookkeeping,", file=sys.stderr)
            print("  --review-annulled <ref>, --strict, --supersedes <id>.", file=sys.stderr)
            print("  NOTHING was written.", file=sys.stderr)
            return 1
        else:
            args.append(tok)
    if len(args) < 2:
        print("usage: led work close <slug> <resolution> (--review-witness <ref> | "
              "--review-deferred | --review-bookkeeping --witness commit:<sha> | "
              "--review-annulled <ref>) [--witness <ref>] [--strict]", file=sys.stderr)
        return 4
    slug, resolution = args[0], args[1]
    if resolution not in ("shipped", "superseded", "dropped", "deferred"):
        print(f"led work close: REFUSED -- resolution must be exactly one of shipped, "
              f"superseded, dropped, deferred (got {resolution!r}). NOTHING was written.",
              file=sys.stderr)
        return 1
    if resolution == "shipped" and not (witness and witness.strip()):
        print("led work close: REFUSED -- resolution=shipped REQUIRES a non-blank --witness "
              "<ref>. NOTHING was written.", file=sys.stderr)
        return 1
    # close-witness-reachability-check (ledger rows 402/336-family): ANY commit-shaped --witness
    # on `led work close` -- not only --review-bookkeeping's mandatory one -- must name a sha
    # reachable from this deployment's own repo HEAD. Checked here, once, before the
    # disposition-specific branches below (which no longer duplicate this check -- see
    # `_commit_witness_reachability_violation`'s own docstring). A witness that is not
    # commit-shaped (prose, row:<id>, artifact:<hash>, a bare ref, ...) never matches
    # `_COMMIT_WITNESS_RE` and is untouched by this gate, per the item's own spec.
    if witness and _COMMIT_WITNESS_RE.match(witness):
        violation = _commit_witness_reachability_violation(_world_root(), witness[len("commit:"):])
        if violation is not None:
            for line in violation:
                print(line, file=sys.stderr)
            return 1
    # claim-before-close gate (led-side; the kernel's own trigger checks only that <slug> was
    # OPENED, not that anyone claimed it) -- run-5 forensics: two work items were closed with no
    # claim ever landing, unflagged.
    if _slug_claimant(cfg, slug) is None:
        print(f"led work close: REFUSED -- slug '{slug}' has no work_claimed row (claim it "
              f"first): ./autoharn led work claim {slug}", file=sys.stderr)
        return 1
    rc_count = sum([bool(review_witness), review_deferred, review_bookkeeping, bool(review_annulled)])
    if rc_count > 1:
        print("led work close: REFUSED -- --review-witness, --review-deferred,", file=sys.stderr)
        print("  --review-bookkeeping, and --review-annulled are the FOUR CONSTRUCTORS of a", file=sys.stderr)
        print("  review disposition; exactly ONE, never more than one, in one close act.", file=sys.stderr)
        return 1
    if rc_count == 0:
        print("led work close: REFUSED -- a review-silent close is unrepresentable.", file=sys.stderr)
        print("  Choose exactly ONE constructor:", file=sys.stderr)
        print("    --review-witness <ref>       a review already exists; cite it", file=sys.stderr)
        print("    --review-deferred            this close act itself becomes the review obligation", file=sys.stderr)
        print("    --review-bookkeeping         a judgment-free close whose entire content is a git", file=sys.stderr)
        print("                                 commit landing -- requires --witness commit:<sha>.", file=sys.stderr)
        print("    --review-annulled <ref>      an authority distinct from the obligor considered", file=sys.stderr)
        print("                                 and declined the review debt, for a recorded reason", file=sys.stderr)
        print("                                 (kernel/lineage/s73-typed-annulment-disposition.sql --", file=sys.stderr)
        print("                                 authored, not yet live on every world; the kernel's", file=sys.stderr)
        print("                                 own refusal, if this world predates it, is definitive).", file=sys.stderr)
        return 1
    if review_deferred and strict:
        print("led work close: REFUSED -- --review-deferred + --strict is a contradiction in "
              "terms.", file=sys.stderr)
        return 1
    if review_bookkeeping and strict:
        print("led work close: REFUSED -- --review-bookkeeping + --strict is a contradiction "
              "in terms.", file=sys.stderr)
        return 1
    if review_annulled and strict:
        print("led work close: REFUSED -- --review-annulled + --strict is a contradiction in "
              "terms (s73's own refusal 3: annulled is legal only where deferred would have "
              "been legal).", file=sys.stderr)
        return 1
    if review_bookkeeping:
        if not witness:
            print("led work close: REFUSED -- --review-bookkeeping requires --witness "
                  "commit:<sha> -- no --witness was given.", file=sys.stderr)
            return 1
        if not _COMMIT_WITNESS_RE.match(witness):
            print(f"led work close: REFUSED -- --review-bookkeeping's --witness {witness!r} "
                  f"failed the COMMIT-SHAPE check (must match ^commit:[0-9a-f]{{7,40}}$).",
                  file=sys.stderr)
            return 1
        # existence + reachability are already checked above, once, for every commit-shaped
        # --witness (close-witness-reachability-check) -- nothing further to do here.
    if review_witness:
        rw_violation = _review_witness_violation(cfg, review_witness)
        if rw_violation is not None:
            for line in rw_violation:
                print(line, file=sys.stderr)
            print("  NOTHING was written.", file=sys.stderr)
            return 1
        disposition, review_ref = "witnessed", review_witness
    elif review_bookkeeping:
        disposition, review_ref = "bookkeeping", witness
    elif review_annulled:
        # NOT a client-side fake of s73's own construction-time checks (the authority-in-force
        # test, the actor/stamp-pair distinctness tests, the mandatory-ref CHECK) -- this shim
        # builds the payload and hands it to the kernel; a pre-s73 world's own
        # work_review_disposition_check CHECK constraint refuses 'annulled' outright (it is not
        # yet a legal value there), and that refusal is reported byte-verbatim by
        # `bcc.write_and_report` below, exactly like any other kernel refusal (ADR-0000's own
        # "ask the kernel by trying, never a hardcoded world-version check").
        disposition, review_ref = "annulled", review_annulled
    else:
        disposition, review_ref = "deferred", None
    if supersedes:
        print(f"led work close: --supersedes {supersedes} -- this close retracts ledger row "
              f"{supersedes} from current truth. If row {supersedes} was itself a work_closed "
              f"row for '{slug}', the item now READS OPEN AGAIN.", file=sys.stderr)
    actor = _resolve_actor(cfg)
    payload: dict = {"kind": "work_closed", "work_slug": slug, "work_resolution": resolution,
                      "work_review_disposition": disposition, "work_strict_close": strict,
                      "statement": f"work_closed: {slug} ({resolution})"}
    if witness:
        payload["work_witness"] = witness
    if review_ref:
        payload["work_review_ref"] = review_ref
    if supersedes:
        payload["supersedes"] = int(supersedes)
    if actor is not None:
        payload["actor"] = actor
    return bcc.write_and_report(cfg.base, "ledger", payload)


def _work_close_positionals(argv: list[str]) -> list[str]:
    """The positional tokens (slug, resolution, ...) of a `led work close`-shaped argv, skipping
    every recognized close flag and its value where it takes one -- the SAME
    `_WORK_CLOSE_VALUE_FLAGS`/`_WORK_CLOSE_BOOL_FLAGS` vocabulary `cmd_work_close`'s own loop
    recognizes (ADR-0012 P1: one home for that vocabulary, not a second hand-copy here). Used by
    `cmd_work_reclose` below to read the slug it needs to look up BEFORE delegating the actual
    close act, unchanged, to `cmd_work_close` -- an unrecognized token is left alone (neither
    consumed as a flag's value nor specially flagged); `cmd_work_close`'s own loop remains the
    one authoritative place a bad flag is refused, once, when the delegated call is made."""
    positionals: list[str] = []
    it = iter(argv)
    for tok in it:
        if tok in _WORK_CLOSE_VALUE_FLAGS:
            next(it, None)
        elif tok in _WORK_CLOSE_BOOL_FLAGS or tok.startswith("--"):
            continue
        else:
            positionals.append(tok)
    return positionals


def cmd_work_reclose(cfg: bcc.ServedConfig, argv: list[str]) -> int:
    """led work reclose <slug> <resolution> [close-contract flags...] (B2, rows 1025/1008/1200):
    supersede-and-reclose in one guided act -- row 1008's own narrowed request, item (a). A CLI
    COMPOSITION over two ordinary acts (find the slug's current work_closed row, then `led work
    close ... --supersedes <that row's id>`), the SAME shape `cmd_work_supersede_cascade` already
    uses for its own two-step compositions (ADR-0012 P2: no new kernel involvement, no second
    close-payload-construction path -- `cmd_work_close` remains the ONE place a work_closed
    payload is built, ADR-0012 P1). This verb never accepts `--supersedes` itself -- it computes
    the ONE correct value (the slug's own current close row) and refuses a hand-supplied one
    rather than silently overriding it (an operator-supplied id here could name the wrong row,
    unrepresentable-error over silent-mismatch, ADR-0002).

    Resolution/disposition/witness vocabulary is NOT re-validated here -- it is `cmd_work_close`'s
    own contract, reused whole (including `--review-annulled <ref>`, s73's own vocabulary): this
    verb's entire job is composing the supersession, not re-deciding what a valid close looks
    like. Requesting `--review-annulled` against a pre-s73 kernel is attempted, not refused
    client-side -- the kernel's own `work_review_disposition_check` CHECK constraint is the
    authority (ADR-0000: ask it by trying), and its refusal surfaces byte-verbatim via
    `bcc.write_and_report`, exactly as any other kernel refusal does."""
    if "--supersedes" in argv:
        print("led work reclose: REFUSED -- --supersedes is not accepted here; this verb", file=sys.stderr)
        print("  computes it itself (the slug's own current close row) so the two can never", file=sys.stderr)
        print("  drift apart. Use 'led work close <slug> ... --supersedes <id>' directly if", file=sys.stderr)
        print("  you need to supersede a DIFFERENT row by hand.", file=sys.stderr)
        return 1
    positionals = _work_close_positionals(argv)
    if len(positionals) < 2:
        print("usage: led work reclose <slug> <resolution> (--review-witness <ref> | "
              "--review-deferred | --review-bookkeeping --witness commit:<sha> | "
              "--review-annulled <ref>) [--witness <ref>] [--strict]", file=sys.stderr)
        print("  Supersedes <slug>'s current work_closed row and issues the corrected close in", file=sys.stderr)
        print("  one act (kernel/lineage/s31-supersession-uniform-retraction.sql).", file=sys.stderr)
        return 4
    slug = positionals[0]
    if _current_row(cfg, "work_opened", slug) is None:
        print(f"led work reclose: REFUSED -- '{slug}' is not currently an in-force work_opened "
              f"item (already superseded, or never opened) -- refusing on this dirty starting "
              f"state rather than guessing what was meant.", file=sys.stderr)
        return 1
    old_close = _current_row(cfg, "work_closed", slug)
    if old_close is None:
        print(f"led work reclose: REFUSED -- '{slug}' has no in-force close row to supersede "
              f"(it currently reads OPEN -- either never closed, or its prior close was already "
              f"superseded and nothing has re-closed it since). Use 'led work close {slug} ...' "
              f"for a fresh close instead; this verb exists to CORRECT an existing close, not to "
              f"mint the first one.", file=sys.stderr)
        return 1
    old_close_id = old_close["id"]
    print(f"led work reclose: superseding '{slug}'s current close (row {old_close_id}) with a "
          f"corrected close...", file=sys.stderr)
    return cmd_work_close(cfg, [*argv, "--supersedes", str(old_close_id)])


_WORK_ITEM_STATES = ("open", "closed")  # work_item_current.state's own closed vocabulary (s33
# Element 4's CASE, kernel/lineage/s33-composite-discharge.sql) -- "claimed" is NOT a member: a
# claimed-but-not-closed item's `state` stays 'open', `claimant` non-null names the claim
# separately. Named at module scope (ADR-0012 P1) rather than inline, the SAME "one home" posture
# `_ARTIFACT_HASH_RE`/`_COMMIT_WITNESS_RE` above already use for a kernel-mirrored shape.


def cmd_work_list(cfg: bcc.ServedConfig, show_all: bool, state: str | None = None,
                   slug: str | None = None, fields: str | None = None) -> int:
    """led-read-projection-flags (this brief, item 1): `state`, when given, REFUSES an
    unrecognized value against `_WORK_ITEM_STATES` and otherwise narrows to EXACTLY that state --
    strictly more than `--all` (both states) or the pre-existing default (state<>'closed') can
    express; `--state closed` alone ("show me only what finished") had no prior spelling.
    `slug`, when given, narrows to that one work item's current row (the ad-hoc single-item
    lookup orchestrator sessions kept reaching for `python3 -c` filters to do). `fields` projects
    via `_project_fields`, same as every other read verb this item touches. Mutual exclusion with
    `--all`/`--state` is enforced by `main`'s own dispatch (REFUSED there, before this function is
    even called) -- kept there rather than here so the refusal fires before any read is issued."""
    if state is not None and state not in _WORK_ITEM_STATES:
        print(f"led work list: REFUSED -- unrecognized --state {state!r} (work_item_current's "
              f"own state column is closed to: {', '.join(_WORK_ITEM_STATES)}).", file=sys.stderr)
        return 4
    rows = bcc.get_all_rows(cfg.base, "/views/work_item_current", cursor="after_slug")
    if slug is not None:
        rows = [r for r in rows if r.get("slug") == slug]
    if state is not None:
        selected = [r for r in rows if r.get("state") == state]
    else:
        selected = rows if show_all else [r for r in rows if r.get("state") != "closed"]
    if fields is not None:
        projected, err = _project_fields(selected, fields, "led work list")
        if err is not None:
            return err
        selected = projected
    for r in selected:
        print(json.dumps(r, sort_keys=True))
    return 0


def cmd_work_violations(cfg: bcc.ServedConfig) -> int:
    rows = bcc.get_all_rows(cfg.base, "/views/work_item_violations", cursor="after_slug")
    for r in rows:
        print(json.dumps(r, sort_keys=True))
    return 0


def cmd_work_asof(cfg: bcc.ServedConfig, ts: str) -> int:
    """DISCLOSED PARTIAL PORT (see this file's own SCOPE comment for the full disclosure):
    reuses GET /rows/asof/{ts} -- the same supersession-filtered reconstruction asof-export.tmpl
    already serves -- filtered client-side to kind in work_opened/work_claimed/work_closed and
    reduced to latest-row-per-slug, exactly as legacy's own three CTEs do. Diverges from legacy
    in exactly one respect: this source route IS supersession-aware (a retracted work_opened row
    correctly disappears once its own retraction lands at-or-before <ts>), where legacy's raw
    event-replay never consults `supersedes` at all."""
    try:
        datetime.datetime.fromisoformat(ts)
    except ValueError:
        print(f"led work asof: REFUSED -- <timestamp> must be a valid ISO-8601 timestamp "
              f"(GET /rows/asof/{{ts}}'s own grammar, stricter than legacy's looser postgres-"
              f"timestamptz-cast acceptance); got {ts!r}.", file=sys.stderr)
        return 4
    print("note: asof is a RAW event-reconstruction (open/claimed/closed only), read through "
          "GET /rows/asof/{ts} -- supersession-aware, which is the one disclosed divergence "
          "from legacy's own raw-replay reconstruction (see this file's own SCOPE comment).",
          file=sys.stderr)
    rows = bcc.get_all_rows(cfg.base, f"/rows/asof/{ts}", cursor="after_id")
    opened: dict[str, dict] = {}
    claimed: dict[str, dict] = {}
    closed: dict[str, dict] = {}
    for r in rows:
        slug = r.get("work_slug")
        if slug is None:
            continue
        kind = r.get("kind")
        if kind == "work_opened":
            if slug not in opened or r["id"] > opened[slug]["id"]:
                opened[slug] = r
        elif kind == "work_claimed":
            if slug not in claimed or r["id"] > claimed[slug]["id"]:
                claimed[slug] = r
        elif kind == "work_closed":
            if slug not in closed or r["id"] > closed[slug]["id"]:
                closed[slug] = r
    for slug in sorted(opened):
        o = opened[slug]
        c = closed.get(slug)
        cl = claimed.get(slug)
        state = "closed" if c else ("claimed" if cl else "open")
        out = {"slug": slug, "title": o.get("work_title"), "state_asof": state,
               "resolution": c.get("work_resolution") if c else None,
               "witness": c.get("work_witness") if c else None,
               "claimant": cl.get("actor") if cl else None}
        print(json.dumps(out, sort_keys=True))
    return 0


def cmd_work_review_gap(cfg: bcc.ServedConfig) -> int:
    """Ported off legacy-led.tmpl's `work review-gap` -- work_review_gap, item-keyed (s29's own
    sibling of the ACTOR-keyed top-level `led review-gap`), read via GET /views/work_review_gap
    (already in VIEW_REGISTRY, keyed on slug). refuse-verdict-legibility (this brief, item 3):
    also carries `review_status`/`reviewing_verdicts` per row (`_review_legibility_for`), the SAME
    enrichment `cmd_review_gap`'s own work_item arm applies -- this sub-verb reads the identical
    view directly, so it gets the identical legibility, not a second, divergent presentation."""
    verdicts = _review_verdicts_by_regards(cfg)
    rows = bcc.get_all_rows(cfg.base, "/views/work_review_gap", cursor="after_slug")
    for r in rows:
        out = dict(r)
        out.update(_review_legibility_for(verdicts, r["close_id"]))
        print(json.dumps(out, sort_keys=True))
    return 0


def cmd_work_startable(cfg: bcc.ServedConfig) -> int:
    """Ported off legacy-led.tmpl's `work startable` -- work_startable (kernel/lineage/
    s39-blocks-start.sql): open, unclaimed items whose blocks-start antecedents (if any) are all
    resolved. Added to VIEW_REGISTRY this same pass (legacy-led-retirement phase 1B, ledger row
    1149) -- a pre-s39 kernel gets the boundary's own capability_absent 404, translated here to
    the same teach-text legacy's own live relation-existence gate prints."""
    try:
