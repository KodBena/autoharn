def _missive_local_world(cfg: bcc.ServedConfig) -> str:
    """led-missive-send: the author-world for EVERY `missive_sent` row this world can ever write
    is THIS DEPLOYMENT'S OWN name -- never a typed flag (a typed --author-world would let an
    operator/agent construct a lie the kernel would refuse one hop later anyway,
    validate_missive_identity's own check; the fact already lives in exactly one place and this
    function is that one home, ADR-0012 P1). Resolved from `cfg.record.name` -- the SAME value
    `bootstrap/new-project.sh`'s own birth sequence writes BOTH into deployment.json's `name`
    field and into `kernel.world_identity.world_name` (world_name is literally `$NAME`/
    `$NEW_WORLD`, the identical script variable that also becomes deployment.json's `name` --
    verified live against that script's own birth-sequence text), so this is not a guess or a
    second, drifting notion of "this world's name" -- it is the ONE fact, read from its
    deployment-side home rather than round-tripping the boundary for it (`GET /health`'s own
    `capabilities.world` field carries `cfg.schema` SERVER-side instead, which only coincides
    with `world_identity` by birth CONVENTION, not by construction, when --schema was given
    explicitly apart from --name -- `cfg.record.name` is the more precise fact of the two
    available client-side today).

    `name` is OPTIONAL on `DeploymentRecord` (a deployment.json predating that field, or one
    scaffolded without `--name`) -- raises `MissiveEnvelopeRefused` rather than falling back to
    `cfg.record.schema` (which could silently diverge from `world_identity` and mint a
    validate_missive_identity refusal ONE ROUND TRIP LATER, worse than refusing here with the
    real reason named)."""
    if not cfg.record.name:
        raise MissiveEnvelopeRefused([
            "led missive send: REFUSED -- this deployment.json carries no 'name' field, and "
            "missive_sent's own author-world MUST be this deployment's name (kernel.world_"
            "identity.world_name, s58 ELEMENT 1) -- never guessed from 'schema', which can "
            "diverge from it. Nothing was written.",
            "  Fix: add a 'name' field to deployment.json matching this world's own "
            "kernel.world_identity.world_name (bootstrap/new-project.sh's --new-world/--name "
            "argument, at birth)."])
    return cfg.record.name


def _missive_next_seq(cfg: bcc.ServedConfig, thread: str) -> int:
    """led-missive-send: the seq-collision refusal a verb prevents by construction (this item's
    own spec) -- reads GET /views/missive_outbound (`cmd_missive_list`'s sibling read, the SAME
    served view, walked to completion the SAME way every other view read in this file already
    is), the served THREAD's OWN transport feed. `missive_outbound` is deliberately the RAW,
    append-complete feed (s59 AMENDMENT 2's own fix, re-issued to read `ledger` not
    `ledger_current`) -- the SAME raw-table denomination `validate_missive_dedup`'s own sent-side
    EXISTS check uses (`kernel/lineage/s58-missive-substrate.sql`'s trigger body: `SELECT 1 FROM
    ledger s WHERE s.kind = 'missive_sent' AND s.missive_thread = ... AND s.missive_seq = ...`,
    NOT `ledger_current`) -- so this function's "next seq" is computed against the EXACT set the
    kernel's own dedup trigger will re-check, never a current-truth-filtered undercount that
    could still collide. `missive_outbound` carries only rows THIS world authored (missive_sent
    is two-way on author_world = this world, validate_missive_identity's own enforcement), so no
    additional author filter is needed here. Returns 1 for a thread with no prior sent rows."""
    seqs = [r["missive_seq"] for r in bcc.get_all_rows(cfg.base, "/views/missive_outbound",
                                                         cursor="after_id")
            if r.get("missive_thread") == thread]
    return (max(seqs) + 1) if seqs else 1


def _missive_resolve_responds_to(cfg: bcc.ServedConfig, ref: str) -> str:
    """led-missive-send's own resolution for `--responds-to`: accepts EITHER an already-formed
    `xrow:<world>:<id>:<row_hash>` token (passed through verbatim after a shape check -- the
    common case when replying to a missive this world itself sent, or citing a token read off
    another served view directly) OR a bare local ledger row id naming a `missive_received` row
    (this world's OWN receipt row) -- ground truth learned at cost this session, restated here:
    the correct xrow to cite when responding to a LOCAL receipt is that receipt's OWN
    `missive_provenance` column, NOT a token hand-assembled from the receipt's own local id/hash
    (the receipt's local id/row_hash identify ITS OWN row in THIS world's ledger, an addressee-
    side fact; `missive_provenance` is the DIFFERENT, already-minted token naming the ORIGINAL
    SENDER's own `missive_sent` row -- s59's `missive_outbound` view mints it at serve time,
    spec §13 item 1, and the courier stamps it onto the `missive_received` row verbatim at
    receipt, `missive_provenance_kind_shape`'s own two-way CHECK making it mandatory there).
    Reads the raw row (`GET /rows/{id}`, matching `_review_witness_violation`'s own EXISTENCE-
    not-in-force denomination immediately below in this file -- a superseded receipt is still a
    real receipt to respond to) rather than `/rows/current`.

    Raises `MissiveEnvelopeRefused` (never returns a partial/guessed token) on: a bare id naming
    no row, a bare id naming a row that is not `kind='missive_received'`, or a string matching
    neither the bare-id nor the xrow: shapes at all."""
    ref = ref.strip()
    if _MISSIVE_RESPONDS_TO_RE.match(ref):
        return ref
    if ref.isdigit():
        rid = int(ref)
        try:
            row = bcc.get_json(cfg.base, f"/rows/{rid}")
        except bcc.BoundaryRefusal as e:
            if e.status != 404:
                raise
            row = None
        if row is None:
            raise MissiveEnvelopeRefused([
                f"led missive send: REFUSED -- --responds-to cites local row {rid}, but no "
                f"ledger row {rid} exists (checked via GET /rows/{rid}, existence not "
                f"in-force status). Nothing was written.",
                f"  Cite an existing missive_received row's id (see 'led missive list'), or an "
                f"already-formed 'xrow:<world>:<id>:<row_hash>' token directly."])
        if row.get("kind") != "missive_received":
            raise MissiveEnvelopeRefused([
                f"led missive send: REFUSED -- --responds-to cites local row {rid}, which "
                f"exists but is a {row.get('kind')!r} row, not a 'missive_received' row -- "
                f"only a LOCAL RECEIPT can be resolved to the xrow it responds to (its own "
                f"missive_provenance). Nothing was written.",
                f"  Cite the id of the actual missive_received row you are responding to (see "
                f"'led missive list'), or an already-formed 'xrow:...' token directly."])
        prov = row.get("missive_provenance")
        if not prov:
            raise MissiveEnvelopeRefused([
                f"led missive send: REFUSED -- --responds-to cites local row {rid} (a "
                f"missive_received row), but it carries no missive_provenance -- structurally "
                f"unexpected (missive_provenance_kind_shape mandates it two-way on "
                f"missive_received); refusing rather than sending an empty responds_to. "
                f"Nothing was written."])
        return prov
    raise MissiveEnvelopeRefused([
        f"led missive send: REFUSED -- --responds-to {ref!r} matches neither a bare local "
        f"ledger row id (a missive_received receipt) nor an 'xrow:<world>:<id>:<row_hash>' "
        f"token shape. Nothing was written.",
        f"  Pass the id of the missive_received row you are responding to (see 'led missive "
        f"list'), or an already-formed 'xrow:...' token."])


def cmd_missive_send(cfg: bcc.ServedConfig, thread: str, act: str, addressee: str,
                      statement: str, responds_to_ref: str | None) -> int:
    """led-missive-send (ledger row 403/336-family): the verb `led missive list`/`led missive
    dispose` already have and `led missive send` did not -- today a send is hand-authored JSON
    through `led --json ledger` (this item's own title, witnessed at cost: a seq collision, row
    161, from a hand-typed seq that raced the thread's real head). This function is the ONE
    write path: seq resolved automatically (`_missive_next_seq`), author-world resolved from
    THIS deployment (`_missive_local_world`, never a typed flag), and the FULL envelope validated
    CLIENT-SIDE against s58's own closed vocabularies (act, protocol, world/thread/xrow shapes,
    the responds_to-mandatory-on-act coupling) BEFORE any POST -- every check here mirrors an
    EXISTING kernel CHECK/trigger one hop earlier (named in each refusal), never invents a new
    rule the kernel does not already enforce (the `_ARTIFACT_HASH_RE`/`_KEY_FINGERPRINT_RE`
    precedent, restated for this family).

    DISCLOSED NARROWING: `act='acknowledgment'` is REFUSED here even though it is a legal
    `missive_act_check` member -- an acknowledgment is the ONE row kind `kernel.missive_dispose`'s
    own two-row ceremony mints itself (ELEMENT 7: author=local world, responds_to=the receipt's
    own provenance, disposition=the disposition, seq computed inside that SAME guarded
    transaction) -- authoring one bare through this generic path would bypass that ceremony's own
    atomicity (a disposed-without-acknowledgment, or acknowledgment-without-disposition, state
    the ceremony exists to make unrepresentable) and races this function's OWN, separately-read
    `_missive_next_seq` against the ceremony's. `led missive dispose` is the correct, and only,
    path to an acknowledgment; this verb's own usage text says so.

    Raises nothing to its own caller -- every `MissiveEnvelopeRefused` from a helper is caught
    HERE, in the one place, printed, and turned into exit 1 with NOTHING written; only a clean
    envelope reaches `bcc.write_and_report`."""
    try:
        if act == "acknowledgment":
            raise MissiveEnvelopeRefused([
                "led missive send: REFUSED -- 'acknowledgment' is not sendable through this "
                "verb: it is minted ONLY by kernel.missive_dispose's own two-row ceremony "
                "(disposition + acknowledgment, one guarded transaction) -- authoring one here "
                "would bypass that atomicity. Nothing was written.",
                "  Use 'led missive dispose <receipt-row-id> <disposition> [statement...]' "
                "instead."])
        if act not in _MISSIVE_ACT_VOCAB:
            raise MissiveEnvelopeRefused([
                f"led missive send: REFUSED -- --act {act!r} is not in the closed vocabulary "
                f"(kernel/lineage/s58-missive-substrate.sql's missive_act_check): "
                f"{', '.join(_MISSIVE_ACT_VOCAB)}. Nothing was written."])
        if not _MISSIVE_THREAD_RE.match(thread):
            raise MissiveEnvelopeRefused([
                f"led missive send: REFUSED -- --thread {thread!r} does not match "
                f"'<minting-world>/<slug>' ({_MISSIVE_THREAD_RE.pattern!r}, missive_thread_shape). "
                f"Nothing was written."])
        if not _MISSIVE_WORLD_RE.match(addressee):
            raise MissiveEnvelopeRefused([
                f"led missive send: REFUSED -- --addressee {addressee!r} does not match "
                f"{_MISSIVE_WORLD_RE.pattern!r} (missive_addressee_world_shape). "
                f"Nothing was written."])
        if not statement or not statement.strip():
            raise MissiveEnvelopeRefused([
                "led missive send: REFUSED -- --statement must be non-blank. Nothing was "
                "written."])
        author_world = _missive_local_world(cfg)
        if addressee == author_world:
            raise MissiveEnvelopeRefused([
                f"led missive send: REFUSED -- --addressee {addressee!r} is THIS world's own "
                f"name (missive_self_missive_refused) -- a world cannot send itself a missive. "
                f"Nothing was written."])
        responds_to = (_missive_resolve_responds_to(cfg, responds_to_ref)
                       if responds_to_ref else None)
        if act in _MISSIVE_RESPONDS_TO_MANDATORY_ACTS and not responds_to:
            raise MissiveEnvelopeRefused([
                f"led missive send: REFUSED -- --act {act!r} REQUIRES --responds-to "
                f"(missive_responds_to_coupling: mandatory on "
                f"{'/'.join(_MISSIVE_RESPONDS_TO_MANDATORY_ACTS)}, optional on assertion/"
                f"request). Nothing was written."])
        seq = _missive_next_seq(cfg, thread)
    except MissiveEnvelopeRefused as e:
        for line in e.lines:
            print(line, file=sys.stderr)
        return 1
    actor = _resolve_actor(cfg)
    payload: dict = {"kind": "missive_sent", "statement": statement,
                      "missive_protocol": 1, "missive_author_world": author_world,
                      "missive_addressee_world": addressee, "missive_thread": thread,
                      "missive_seq": seq, "missive_act": act}
    if responds_to:
        payload["missive_responds_to"] = responds_to
    if actor is not None:
        payload["actor"] = actor
    return bcc.write_and_report(cfg.base, "ledger", payload)


_ARTIFACT_MEDIA_EXT_MAP = {".md": "text/markdown", ".markdown": "text/markdown",
                           ".toml": "application/toml", ".json": "application/json"}


def cmd_artifact_put(cfg: bcc.ServedConfig, path: str, media_type: str | None) -> int:
    """design/FABLE-LEGACY-LED-RETIREMENT-SPEC.md Part B: POST /artifacts, targeting
    kernel.artifact_write (kernel/lineage/s51-artifact-store.sql) through the boundary. Grammar
    and media_type-inference-by-extension are byte-for-byte legacy-led.tmpl's own (see that
    file's own `artifact put` case) -- the size cap is enforced by the kernel alone (P1: no
    second size limit; the boundary route imposes no artifact-specific bound of its own, see
    serving/boundary_service.py's MAX_ARTIFACT_BODY_BYTES docstring for the buffering-only bound
    that DOES exist). NOTED, not changed (row 1173 review round 1, minor 4): legacy's own
    `artifact put` built its payload through a `psql -v` bind and a shell heredoc, where a
    filename/media-type containing a quote character was a live quoting hazard this file's
    reviewers checked for here too. This port carries no such hazard BY CONSTRUCTION, not by a
    quoting fix: `path`/`media_type` never touch a shell command line or a SQL literal at all --
    the file's bytes are base64-encoded straight into a JSON POST body (`bcc.post_artifact`),
    and `path` itself is only ever a Python `Path` argument. Confirmed fine as-is."""
    p = Path(path)
    if not p.is_file():
        print(f"led artifact put: REFUSED -- {path!r} does not exist or is not a regular file "
              f"-- nothing to register.", file=sys.stderr)
        return 1
    data = p.read_bytes()
    media = media_type or _ARTIFACT_MEDIA_EXT_MAP.get(p.suffix.lower(), "text/plain")
    actor = _resolve_actor(cfg)
    payload: dict = {"bytes": base64.b64encode(data).decode("ascii"), "media_type": media}
    if actor is not None:
        payload["actor"] = actor
    exit_code, verdict = bcc.post_artifact(cfg.base, payload)
    if exit_code == 0:
        print(f"led artifact put: {verdict.get('message')} (from {path})")
        return 0
    sys.stderr.write(
        f"led artifact put: REFUSED by the kernel write boundary (SQLSTATE {verdict.get('sqlstate')}; "
        f"journaled as write_refused row {verdict.get('refusal_id')}):\n"
        f"  {verdict.get('message')}\n")
    return 1


def cmd_artifact_get(cfg: bcc.ServedConfig, hash_: str, out: str | None) -> int:
    """design/FABLE-LEGACY-LED-RETIREMENT-SPEC.md Part B: GET /artifacts/{hash}. Re-verifies the
    received bytes against `hash_` CLIENT-SIDE too -- belt-and-braces with the boundary's own
    server-side re-verification on the way out (serving/boundary_service.py's `artifact_get`),
    preserving legacy-led.tmpl's own WA6 corruption-drill teach-text byte-for-byte (a corrupt
    store must fail loud here too, never serve silently-wrong bytes, even if the server-side
    check somehow regressed)."""
    if not _ARTIFACT_HASH_RE.match(hash_):
        print(f"usage: led artifact get <64-hex-char-sha256-hash> [--out <path>]", file=sys.stderr)
        return 4
    try:
        raw, _content_type = bcc.get_bytes(cfg.base, f"/artifacts/{hash_}")
    except bcc.BoundaryRefusal as e:
        if e.status == 404:
            print(f"led artifact get: REFUSED -- no artifact registered with hash '{hash_}'.",
                  file=sys.stderr)
            print("  See 'led artifact stat <hash>' to check, or 'led artifact put <path>' to "
                  "register one.", file=sys.stderr)
            return 1
        raise
    computed = hashlib.sha256(raw).hexdigest()
    if computed != hash_:
        print(f"led artifact get: REFUSED -- CORRUPT STORE -- the bytes returned for hash",
              file=sys.stderr)
        print(f"  '{hash_}' do NOT hash to '{hash_}' (computed '{computed}' instead).",
              file=sys.stderr)
        print("  kernel/lineage/s51-artifact-store.sql: a corrupt store fails loud here, never",
              file=sys.stderr)
        print("  serves silently-wrong bytes under a claimed hash. Nothing was written.",
              file=sys.stderr)
        return 1
    if out:
        Path(out).write_bytes(raw)
        print(f"led artifact get: wrote {hash_} -> {out} (hash verified).", file=sys.stderr)
    else:
        sys.stdout.buffer.write(raw)
    return 0


