class MissiveEnvelopeRefused(Exception):
    """led-missive-send's own typed refusal carrier: `cmd_missive_send` and the helpers it calls
    (`_missive_next_seq`'s callers, `_missive_resolve_responds_to`) raise this with the COMPLETE
    REFUSED teach-text (one or more stderr lines, vocabulary named) the instant a client-side
    envelope check fails -- caught in exactly ONE place (`cmd_missive_send`'s own try/except),
    printed, nothing POSTed. Mirrors `_build_or_refuse`'s ValueError-to-REFUSED translation for
    the principal-payload dataclasses above, adapted to a MULTI-LINE teach-text (this family's
    refusals routinely name the vocabulary AND the fix, `_review_witness_violation`'s own
    list[str] shape) rather than principal's single-sentence ValueError message."""

    def __init__(self, lines: list[str]) -> None:
        super().__init__("\n".join(lines))
        self.lines = lines


def _load_config() -> bcc.ServedConfig:
    try:
        cfg = bcc.load_served_config(DEPLOYMENT_PATH)
    except bcc.BoundaryClientError as e:
        print(f"led: {e}", file=sys.stderr)
        sys.exit(4)
    # Version handshake (design/FABLE-AUTOHARN-UMBRELLA-CLI-SPEC.md §3): checked ONCE here, the
    # single choke point every served call already passes through (ADR-0012 P1), before any real
    # read/write is issued. `ProtocolVersionMismatch` propagates to `main`'s own top-level
    # exception mapping (mirrors BoundaryRefusal/BoundaryUnreachable there).
    try:
        bcc.check_protocol_version(cfg.base, cfg.record.boundary_url)
    except bcc.BoundaryUnreachable:
        # Ensure-running (design/FABLE-AUTOHARN-UMBRELLA-CLI-SPEC.md §2, round-1 review
        # DIRECTED WORK): unreachable -> spawn per this deployment's own record, print ONE
        # line, then proceed -- retried below ONCE; if that retry still raises, the
        # EXISTING BoundaryUnreachable handling in this file's own top-level dispatch is
        # the refusal shown (this call invents no new refusal shape of its own).
        er.ensure_running_or_leave_unreachable(DEPLOYMENT_PATH, 'led')
        bcc.check_protocol_version(cfg.base, cfg.record.boundary_url)
    return cfg


def _resolve_actor(cfg: bcc.ServedConfig) -> int | None:
    """LED_ACTOR (env var, not a flag) -- byte-identical semantics to the legacy tool's own
    `resolve_actor()`: unset means the payload omits `actor` entirely (the kernel's own
    `set_actor` default-resolution applies); set to an unregistered name REFUSES with teach-text,
    never a silent fallback to the default principal."""
    name = os.environ.get("LED_ACTOR", "")
    if not name:
        return None
    rows = bcc.get_all_rows(cfg.base, "/standing/principals", cursor="after_id")
    for r in rows:
        if r.get("name") == name:
            return r["id"]
    print(f"led: REFUSED -- LED_ACTOR={name!r} is not a registered principal.", file=sys.stderr)
    print(f"  Register it first: ./autoharn led register-principal {name} <human|model|subagent|tool>", file=sys.stderr)
    sys.exit(1)


def _principals_by_name(cfg: bcc.ServedConfig) -> dict[str, int]:
    """Name -> id map off GET /standing/principals, walked to completion -- the SAME read
    `cmd_obligate`/`_resolve_actor` already use for principal-name resolution (shared lookup,
    not a second mechanism, ADR-0012 P1)."""
    rows = bcc.get_all_rows(cfg.base, "/standing/principals", cursor="after_id")
    return {r["name"]: r["id"] for r in rows}


