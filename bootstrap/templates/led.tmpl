def _live_kind_vocab(cfg: bcc.ServedConfig) -> list[str] | None:
    """led-read-projection-flags (this brief, item 1): the SAME `GET /kinds` re-query
    `boundary_cli_client._kind_refusal_teach` already uses AFTER a kernel refusal, reused here
    BEFORE issuing a read so `--kind` gets a typed refusal against the live vocabulary rather
    than silently matching zero rows (ADR-0012 P1 -- one home for "what is a live kind",
    consulted from both call sites, never a second hardcoded list). Returns None (never raises)
    on any boundary failure reaching /kinds -- callers degrade to "cannot validate, proceed
    unvalidated" exactly like `_kind_refusal_teach`'s own disclosed degrade, never a hang."""
    try:
        body = bcc.get_json(cfg.base, "/kinds")
    except (bcc.BoundaryRefusal, bcc.BoundaryUnreachable):
        return None
    kinds = body.get("kinds") if isinstance(body, dict) else None
    return kinds if isinstance(kinds, list) and kinds else None


def _project_fields(rows: list[dict], fields_arg: str, verb_label: str) -> tuple[list[dict] | None, int | None]:
    """led-read-projection-flags (this brief, item 1): the ONE home `--fields` projection goes
    through for every read verb below (`--recent`/`current`/`show`/`work list`) -- comma-split,
    each name checked against the UNION of keys actually present across `rows` (the live row
    shape this exact read just served, never a second hand-maintained column list that could
    drift from a kernel view's real columns). An unrecognized field name is a typed REFUSED
    (teaching the known field set), never a silently field-less/empty row -- the same "refusals
    that teach, never silent empties" discipline item 1's own commissioning text names. DISCLOSED
    EDGE CASE: when `rows` is itself empty (nothing came back from the live read at all,
    independent of any --fields request), there is no live shape to check names against -- field
    names are accepted unvalidated in that case (there is nothing to violate; the caller's own
    empty-rows read is already the honest signal, not a --fields bug).

    Returns `(projected_rows, None)` on success, or `(None, exit_code)` with the refusal already
    printed to stderr -- callers `return` that exit_code unchanged, the same shape
    `_build_or_refuse`/`cmd_show`'s own 404 branch already use for "caller returns whatever this
    helper decided"."""
    requested = [f.strip() for f in fields_arg.split(",") if f.strip()]
    if not requested:
        print(f"{verb_label}: REFUSED -- --fields requires at least one (comma-separated) field "
              f"name.", file=sys.stderr)
        return None, 4
    known = sorted({k for r in rows for k in r.keys()})
    unknown = [f for f in requested if known and f not in known]
    if unknown:
        print(f"{verb_label}: REFUSED -- unrecognized field name(s) {unknown} (known fields for "
              f"this read: {known}).", file=sys.stderr)
        return None, 4
    return [{k: r.get(k) for k in requested} for r in rows], None


def _current_rows(cfg: bcc.ServedConfig, kind: str, **filters) -> list[dict]:
    """GET /rows/current (the in-force, supersession-filtered read every other verb in this
    file already uses -- see `_current_row` below `cmd_work_startable`) filtered client-side to
    `kind` plus an exact match on every `filters` keyword -- the SAME no-server-side-filter-
    grammar discipline the whole rebase is built on."""
    out = []
    for r in bcc.get_all_rows(cfg.base, "/rows/current", cursor="after_id"):
        if r.get("kind") != kind:
            continue
        if all(r.get(k) == v for k, v in filters.items()):
            out.append(r)
    return out


def _latest_current(cfg: bcc.ServedConfig, kind: str, **filters) -> dict | None:
    rows = _current_rows(cfg, kind, **filters)
    return max(rows, key=lambda r: r["id"]) if rows else None


