def _review_verdicts_by_regards(cfg: bcc.ServedConfig) -> dict[int, list[dict]] | None:
    """refuse-verdict-legibility (this brief, item 3): every un/superseded row of
    `/views/review_verdicts` (kernel/lineage/s56-reservation-residue.sql's own general
    review-legibility surface -- review_id, regards, reviewer, verdict, independence, basis,
    antecedent, superseded -- ALREADY SERVED, no kernel/serving change), keyed by `regards` (the
    ledger row id a review targets -- review_gap's own `id` for the actor-keyed arm,
    work_review_gap's own `close_id` for the item-keyed arm, both compared against this SAME
    column). Returns None (never raises) on a pre-s56 kernel (404) -- callers degrade to
    "legibility unavailable" rather than fabricating a verdict client-side (item 3's own
    STOP-and-report-the-gap instruction; this repo's OWN world is s56+, so the degrade path is
    named for portability, not expected to fire here)."""
    try:
        rows = bcc.get_all_rows(cfg.base, "/views/review_verdicts", cursor="after_id")
    except bcc.BoundaryRefusal as e:
        if e.status == 404:
            return None
        raise
    out: dict[int, list[dict]] = {}
    for r in rows:
        out.setdefault(r["regards"], []).append(r)
    return out


def _review_legibility_for(verdicts_by_regards: dict[int, list[dict]] | None, regards_id: int) -> dict:
    """refuse-verdict-legibility (this brief, item 3): CLI-PRESENTATION-LAYER-ONLY distinction
    between "reviewed and refused/not-discharging" and "never reviewed" -- ADR-0008 names
    conflating these as fuzzy-matching, and a bare review-gap/work-review-gap row alone cannot
    tell them apart (both simply fail the SAME discharge test). A row absent from
    `verdicts_by_regards` has NO un-superseded review row regarding it at all (`review_status`:
    "never-reviewed"). A row present but still failing the discharge test WAS reviewed -- verdict
    named, `review_status`: "reviewed-not-discharging" -- covering every way a review can fail to
    discharge review_gap's own anti-join: verdict <> 'attest' (a genuine refuse or
    attest_with_reservations), OR verdict = 'attest' by the SAME actor (review_gap's own
    `reviewer <> actor`/`reviewer <> closer` predicate excludes self-review from counting as
    discharge, but the review row itself still exists and is shown here). Returns `{}`
    (no enrichment) when `verdicts_by_regards` is None -- the caller's own degrade, not faked."""
    if verdicts_by_regards is None:
        return {}
    live = [v for v in verdicts_by_regards.get(regards_id, []) if not v.get("superseded")]
    if not live:
        return {"review_status": "never-reviewed"}
    return {"review_status": "reviewed-not-discharging",
            "reviewing_verdicts": [{"reviewer": v.get("reviewer"), "verdict": v.get("verdict"),
                                     "independence": v.get("independence")} for v in live]}


def cmd_review_gap(cfg: bcc.ServedConfig) -> int:
    """led-review-gap-false-clean (this brief, item 2): bare `led review-gap` used to read ONLY
    `/views/review_gap` (actor-keyed, non-work-item debt) -- silently empty whenever every
    outstanding gap was WORK-ITEM debt (`/views/work_review_gap`), a false-clean read (hazard
    class: an operator/agent trusting the empty output concludes "no review debt" when
    `led work review-gap` alone would have shown otherwise).

    Fix: both sources are read here and EVERY row is labeled `gap_kind` ("actor" | "work_item")
    rather than merged into one indistinguishable shape -- the two views carry genuinely
    different columns (id/actor/scope/assigned_by vs. slug/close_id/closer) and silently
    flattening them into one row shape would itself be the ADR-0008 fuzzy-match item 3 (this same
    brief) exists to refuse. Chosen over the brief's OTHER offered option (refuse-and-point-at-
    'led work review-gap') because `review-gap`'s own EXISTING NAME already promises "my review
    debt", full stop -- narrowing its own bare form to "my non-work-item review debt only" is the
    surprising reading, not the honest one; a caller who wants exactly one source unmixed still
    has `led work review-gap` (unchanged) or the raw `/views/review_gap` route directly. Also
    carries item 3's `review_status`/`reviewing_verdicts` enrichment (`_review_legibility_for`)."""
    verdicts = _review_verdicts_by_regards(cfg)
    rows = bcc.get_all_rows(cfg.base, "/views/review_gap", cursor="after_id")
    for r in rows:
        out = dict(r)
        out["gap_kind"] = "actor"
        out.update(_review_legibility_for(verdicts, r["id"]))
        print(json.dumps(out, sort_keys=True))
    try:
        work_rows = bcc.get_all_rows(cfg.base, "/views/work_review_gap", cursor="after_slug")
    except bcc.BoundaryRefusal as e:
        if e.status == 404:
            print("led review-gap: NOTE -- this world's kernel predates kernel/lineage/"
                  "s29-work-item-ledger.sql; work-item review-gap debt cannot be checked from "
                  "here (nothing further to add to the actor-keyed rows above).", file=sys.stderr)
            return 0
        raise
    for r in work_rows:
        out = dict(r)
        out["gap_kind"] = "work_item"
        out.update(_review_legibility_for(verdicts, r["close_id"]))
        print(json.dumps(out, sort_keys=True))
    return 0


