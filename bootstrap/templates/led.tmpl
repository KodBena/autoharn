    ("resource:", _check_resource),
    ("estimate:", _check_estimate),
    ("actual:", _check_actual),
    ("taxon:", _check_taxon),
    ("interface:", _check_interface),
    ("outcome:", _check_outcome),
    ("review-done:", _check_review_done),
    ("review:", _check_review_queue),
]


def _preflight_grammar(statement: str) -> bool:
    """Returns True if `statement` is either subject to none of the eight ported grammars
    (resource:/estimate:/actual:/taxon:/interface:/outcome:/review:/review-done: -- the
    original six from phase 1 plus actual:/outcome: added phase 1B, ledger row 1149), or
    subject to one and it validates; False (having already printed REFUSED teach-text to
    stderr, byte-identical to legacy-led.tmpl's own) if a recognized prefix's statement fails
    its own grammar. Runs ONLY on the generic <kind> <statement...> write path (cmd_generic),
    exactly where legacy runs its checks -- never on `led review`/`led work *`, which build
    their own statements from typed fields, not user free text under one of these prefixes."""
    trimmed = statement.lstrip()
    for prefix, checker in _GRAMMAR_CHECKERS:
        if trimmed.startswith(prefix):
            return checker(trimmed)
    return True


_CLI_USAGE_HELP_TOKEN_RE = re.compile(r'(?:^|\s)--help(?:\s|$)')
_CLI_USAGE_LINE_RE = re.compile(r'(?:^|\n)\s*usage:\s', re.IGNORECASE)
_CLI_USAGE_FLAG_RE = re.compile(r'(?:^|\s)--[a-zA-Z][\w-]*')
_CLI_USAGE_FLAG_RUN_THRESHOLD = 3

# ledger row 1246 (led-decision-help-garbage-gap): the CLI-usage-guard fingerprint (1) above
# already catches a `--help`/`--foo` DASH-prefixed token anywhere in the statement -- but a BARE,
# non-dash help-seeking word as the ENTIRE statement (`led decision help`) matches none of the
# three existing fingerprints (no dash, no 'usage:' line, no flag run) and was never a member of
# LED_FLAG_VOCAB/`refuse_flag_in_statement`'s own vocabulary either (that guard only refuses a
# statement word that is an EXACT match for a KNOWN led FLAG token -- `help` gates no ledger
# column, so it was never a member -- seen-red/led-help-token-closure/run_fixtures.py's own
# REDISCOVERED-GAP-BARE-HELP module docstring). This is the SAME defect class the garbage-
# statement guard exists to close (a help-seeking, content-free word landing as a PERMANENT
# ledger row) reopened by the CLI rebase for exactly this one non-dash-prefixed token class.
# Enumerated here as a CLOSED vocabulary (never a substring/prefix match -- "please help me
# understand X" is ordinary prose and must stay accepted): the statement, once whitespace-
# normalized and casefolded, is EXACTLY one of these bare, dash-free help-seeking tokens, and
# carries no other word.
_BARE_HELP_STATEMENT_TOKENS = {"help", "-h", "--help", "h", "?"}


def _cli_usage_guard_violation(statement: str) -> str | None:
    """Ledger row 1159 (garbage-statement guard, class-ratified fail-safe additive-refusal
    lane): the maintainer's own testimony -- 'I've never been able to understand the syntax of
    ./led and always too afraid to try, lest I add something to the ledger by mistake... fumbled
    agent invocations have WRITTEN CLI usage text into a ledger as permanent rows.' This is a
    HEURISTIC NET OVER THE CLASS (ADR-0011 Rule 4), never an exhaustive parser of every CLI's
    own usage-text shape -- four independent, deliberately loose fingerprints, any one of which
    is enough: (1) a bare `--help` token (the single most common fumbled-invocation residue);
    (2) a `usage:` line (argparse's/legacy-led.tmpl's own convention, and this file's own,
    verbatim); (3) a RUN of three or more `--flag`-shaped tokens (captured multi-option usage/
    help text reads as a dense cluster of these; an ordinary prose statement essentially never
    does); (4) the WHOLE statement, whitespace-normalized, is nothing but a bare help-seeking word
    (ledger row 1246 -- `_BARE_HELP_STATEMENT_TOKENS`, a closed vocabulary, exact match only, so
    prose that merely CONTAINS the word 'help' is never caught). Returns the violation's own
    human-readable reason, or None when the statement is clean. Runs ONLY on the generic <kind>
    <statement...> write path (cmd_generic), exactly where `led review`/`led work *` do NOT run
    it -- those build their statements from typed fields, never raw user free text captured from
    a terminal."""
    if statement.split() and statement.strip().casefold() in _BARE_HELP_STATEMENT_TOKENS:
        return ("is nothing but a bare help-seeking word "
                f"({sorted(_BARE_HELP_STATEMENT_TOKENS)}) -- a help-seeking invocation, not "
                "authored ledger content")
    if _CLI_USAGE_HELP_TOKEN_RE.search(statement):
        return "contains a bare '--help' token"
    if _CLI_USAGE_LINE_RE.search(statement):
        return "contains a 'usage:' line"
    flag_hits = _CLI_USAGE_FLAG_RE.findall(statement)
    if len(flag_hits) >= _CLI_USAGE_FLAG_RUN_THRESHOLD:
        sample = ", ".join(sorted({h.strip() for h in flag_hits})[:5])
        return f"contains a run of {len(flag_hits)} option-flag-shaped tokens ({sample}, ...)"
    return None


# --- artifact-claim-dereference-guard (ledger row 1245, CLI-REBASE FEATURE-LOSS repair) --------
# REHOMED HERE, CLI-SIDE, deliberately: this is the SAME layer the garbage-statement guard above
# and the eight statement grammars above THAT already live at (cmd_generic's own pre-flight,
# right before a payload is ever built) -- a check against THIS OPERATOR'S OWN FILESYSTEM, which
# only the CLI process (running on the operator's own checkout) can see; the boundary service
# (serving/boundary_service.py) runs wherever the deployment's boundary_url points, not
# necessarily this filesystem at all, so a boundary-side dereference would be dereferencing the
# WRONG filesystem for a local `--evidence <path>` claim. Ported byte-faithfully off the legacy
# tool's own final shape (git show b77ee7a, then the night-build-defect-repair follow-on
# recovered from the pre-retirement legacy-led.tmpl at commit 93affa0^ -- see this item's own
# ledger row 1245 and seen-red/artifact-claim-dereference-guard/run_fixtures.py's REDISCOVERED-GAP
# cases, which this repair flips back from "gap reproduced" to "guard holds").
#
# THE ORIGINAL SPECIMEN CLASS (ledger rows 896-899): row 896 recorded an artifact-written-at-
# <path> claim; row 897 is the correction -- the Write silently landed at a DIFFERENT, mistyped
# path, so "the Write call returned success" witnessed A path, not THE claimed path; row 898
# names the cheap universal check the specimen skipped (ls/wc of the exact claimed path) and the
# class itself, artifact-claim-without-dereference; row 899 opened the item. Detection is
# PATH-SHAPED, not "any string that could be a filesystem location" -- deliberately narrow so
# free-text evidence (commit lists, prose, ledger citations) is never mistaken for a path:
#   - row:<id> (led's own existing bare-reference citation form -- "a bare reference uses refs")
#     and anything containing "://" (a URL) are NEVER path-shaped -- never checked, no exception
#     needed because they were never claiming a LOCAL dereferenceable path in the first place.
#   - anything starting with "/" or "./", or containing a "/" path separator anywhere, IS
#     path-shaped -- cheap to check, so it is checked, unconditionally, before the write below.
def _is_path_shaped(token: str) -> bool:
    if token.startswith("row:") or "://" in token:
        return False
    return token.startswith("/") or token.startswith("./") or "/" in token


def _evidence_dereference_violation(evidence: str) -> list[str] | None:
    """Returns the REFUSED teach-text (as a list of stderr lines), or None if `evidence` passes
    (either not path-shaped at all, or path-shaped and a live regular file, or path-shaped and an
    EXPLICITLY-cited directory via a trailing '/'). A path-shaped value that does not exist is
    refused; one that exists but is a bare (no trailing slash) directory is ALSO refused --
    `Path.exists()` is true for a directory too, but row 898's own remediation is explicitly
    'ls/wc of a FILE', so a bare directory citation reads as satisfying that remediation without
    actually doing so (the directory-vs-file distinction this item's own night-build-defect-
    repair follow-on closed, and the rebase silently dropped along with the rest of the guard)."""
    if not _is_path_shaped(evidence):
        return None
    p = Path(evidence)
    if not p.exists():
        return [
            f"led: REFUSED -- --evidence {evidence!r} is path-shaped (starts with / or ./, or "
            f"contains a path separator) but nothing exists at that path right now.",
            "  This is the artifact-claim-without-dereference class (ledger rows 896-899): a "
            "Write to a mistyped path can succeed silently, and 'the Write call returned "
            "success' witnesses A path, not THE claimed path -- row 898's cheap universal "
            "check (ls/wc of the exact claimed path) is the one the specimen skipped.",
            "  If the artifact is real but genuinely not on this checkout yet, do not cite it "
            "as a bare path that cannot dereference: cite an antecedent ledger row that "
            "describes it instead, e.g. --refs row:<id> (led's own existing 'a bare "
            "reference uses refs' citation form) -- or re-run once the path is real.",
        ]
    if p.is_dir():
        if evidence.endswith("/"):
            return None  # trailing slash = an explicit, deliberate directory citation -- accepted
        return [
            f"led: REFUSED -- --evidence {evidence!r} exists but is a DIRECTORY, not a file "
            f"(night-build-defect-repair: filesystem existence is also true for a directory, "
            f"but row 898's remediation is explicitly 'ls/wc of a FILE' -- a bare directory "
            f"citation reads as satisfying that remediation without actually doing so).",
            f"  If you deliberately mean to cite the directory itself as the artifact, repeat "
            f"the flag with a trailing slash to say so explicitly:",
            f"    --evidence '{evidence}/'",
            "  Otherwise cite the specific file inside it that is the actual evidence.",
        ]
    if not p.is_file():
        return [
            f"led: REFUSED -- --evidence {evidence!r} exists but is not a regular file (a "
            f"symlink to nowhere, a device, a socket, or similar) -- cite the concrete file "
            f"the artifact claim actually points at.",
        ]
    return None


# STATEMENT PATH-SHAPE SCAN (night-build-defect-repair's own register (a) closing the SAME item:
# the dereference guard above only ever looked at --evidence, never at $statement, and the
# ORIGINAL rows 896-897 specimen was a path embedded IN THE STATEMENT TEXT itself
# ("artifact written at <path>"), not passed via --evidence at all -- so the guard above alone
# would never have caught its own motivating case). Called at the generic <kind> <statement...>
# write path (cmd_generic) and at `led review` (cmd_review) -- the two places this served CLI
# assembles a statement from raw user free text; `led work *`'s statements are built by this
# file itself from typed fields (slug/title/resolution), never raw user free text, so there is no
# user-suppliable path-shaped token there to scan -- not a gap, just nothing to check.
#
# WARN-ONLY, deliberately asymmetric to --evidence's hard REFUSE above: --evidence is a
# dedicated, single-purpose flag whose entire job is to assert "this artifact exists, right now,
# dereference it" -- there is no legitimate reason for it to name a path that does not yet exist,
# so refusing is exactly right. A STATEMENT is free-text narration of an event; a path token
# inside it can legitimately describe something ABOUT TO be created ("writing the spec to
# design/X.md next"), something that exists on a different host/checkout than this one, or a path
# quoted verbatim from someone else's report -- treating every such mention as a hard claim-of-
# existence-now would refuse honest prose. A miss here is exactly what row 898 itself calls a
# cheap check that a HUMAN reader should not have to notice unaided -- so it surfaces as a
# WARNING, never a blocked write. AUTOHARN_BACKFLOW finding 5's own fix (collapse per-token
# warning spam to one preamble + a list) is preserved here: N flagged tokens print ONE preamble
# and an N-item list, never the paragraph repeated N times.
def _warn_path_shaped_in_statement(statement: str) -> None:
    flagged: list[str] = []
    for word in statement.split():
        if _is_path_shaped(word) and not Path(word).exists():
            flagged.append(word)
    if not flagged:
        return
    print("led: WARNING -- the statement contains path-shaped token(s) with nothing at that path "
          "right now (artifact-claim-dereference-guard / night-build-defect-repair: the original "
          "ledger rows 896-897 specimen was exactly this shape -- a path embedded in STATEMENT "
          "PROSE, not passed via --evidence).", file=sys.stderr)
    print("  WARN-ONLY, not a refusal: a statement may legitimately narrate a path that is about "
          "to be created, or one that lives on a different host/checkout. If this statement is "
          "asserting the artifact exists NOW, re-check the token(s) below before trusting this "
          "row later.", file=sys.stderr)
    for word in flagged:
        print(f"    - {word}", file=sys.stderr)


# CONTENT-FREE-REVIEW-STATEMENT TRIPWIRE (guard-trio's third member; strengthened-tier review of
# this arc's own row-1245/1600 commit caught the gap, MODERATE/SILENT: legacy-led.tmpl's `led
# review` case called this SIBLING guard immediately alongside warn_path_shaped_in_statement (git
# show 93affa0^:bootstrap/templates/legacy-led.tmpl, the `review` case, both calls back to back
# right after `statement="$*"`), but only the path-shape scanner was ported into this served
# CLI's cmd_review -- this one was silently left behind. Ported here, faithfully, as this file's
# third sibling of the same shape.
#
# TRACKER ITEM `content-free-review-audit`; WITNESSED SPECIMEN: run12 ledger row 20,
# statement="test" (4 chars) -- a review row whose ENTIRE statement was 4 characters mechanically
# discharged another row's countersign obligation under `<schema>.review_gap`'s own semantics
# (kernel/lineage/s13-schema.sql: ANY unsuperseded, distinct-actor `attest` review discharges --
# content is NEVER examined by the view). None of run12's six reviewer passes ever caught it; it
# stands attested in the append-only record.
#
# WARN-ONLY, mirrors _warn_path_shaped_in_statement's own posture (same function shape, same
# tone) -- unlike a hard REFUSE, a legitimately terse review DOES exist ("Confirmed, matches row
# 4's stated criteria exactly." clears easily), so a false positive here is a harmless notice,
# never a blocked write -- the write PROCEEDS either way. The retroactive, content-EXAMINING half
# of this check lives in engine/review_gap_audit.py (`./audit --review-gap`) -- this tripwire is
# intake-time and length-only, exactly the honest limit that module's own docstring names.
#
# THE SHARED THRESHOLD LIVES ONE PLACE (ADR-0012 P1): engine/review_gap_thresholds.py, imported
# directly at top-of-file as `rgt` (house Python idiom -- the bash original had to shell out to
# `python3 engine/review_gap_thresholds.py "$text"` and parse a `FLAGGED <n>`/`CLEAN <n>` line
# because bash cannot import Python; this file is already Python, so it calls
# `rgt.is_content_free`/`rgt.normalize` directly -- same one-home threshold, no subprocess, no
# hand-copied number). The bash original's own fail-open posture ("Fails OPEN on any subprocess
# trouble ... a tripwire that cannot run must never block the write it is only ever supposed to
# warn about") is preserved in spirit: an import-time failure of `review_gap_thresholds` already
# takes the whole CLI down via the top-of-file ImportError guard above (fail-closed, before any
# command ever runs) rather than this function ever needing its own runtime try/except -- there
# is no in-flight subprocess step left to fail once the call is a direct, already-validated
# import.
def _warn_content_free_review_statement(statement: str) -> None:
    if not rgt.is_content_free(statement):
        return
    n = len(rgt.normalize(statement))
    print(f"led: WARNING -- this review's statement is very short ({n} whitespace-normalized "
          f"chars). engine/review_gap_audit.py (./audit --review-gap, tracker item "
          f"'content-free-review-audit') will FLAG this row if it discharges a countersign "
          f"obligation -- state what you actually checked, not just the verdict.", file=sys.stderr)
    print("  (warn-only tripwire, not a refusal -- a legitimate terse review exists; the write "
          "proceeds either way)", file=sys.stderr)


_JSON_SURFACES = ("ledger", "review", "registration", "obligation", "obligation_revoke",
                   "missive_dispose")
# json-write-surface-parity (this brief, item 4): `led --json` used to reach only the FIRST four
# of these -- `cmd_obligate_revoke`/`cmd_missive_dispose` above already POST /write/obligation_
# revoke and /write/missive_dispose (both live in serving/boundary_service.py's own WRITE_SURFACES
# dict and WRITE_SURFACE_INT_FIELDS, unchanged by this item), so the ONLY gap was this CLI's own
# `cmd_json` allowlist never naming them -- closed here by WIDENING the allowlist, not by adding
# any new route/kernel behavior (P2: no second validator, `bcc.write_and_report` still hands the
# payload to the SAME boundary function these two prose verbs already call).


def cmd_json(cfg: bcc.ServedConfig, surface: str, source: str) -> int:
    if surface not in _JSON_SURFACES:
        print(f"led --json: REFUSED -- unrecognized surface {surface!r} (expected one of "
              f"{', '.join(_JSON_SURFACES)})", file=sys.stderr)
        return 4
    text = sys.stdin.read() if source == "-" else Path(source).read_text(encoding="utf-8")
    try:
        payload = json.loads(text)
    except json.JSONDecodeError as e:
        print(f"led --json: REFUSED -- {source} is not valid JSON ({e})", file=sys.stderr)
        return 4
    if not isinstance(payload, dict):
        print(f"led --json: REFUSED -- payload must be a JSON object, got {type(payload).__name__}",
              file=sys.stderr)
        return 4
    return bcc.write_and_report(cfg.base, surface, payload)


def cmd_recent(cfg: bcc.ServedConfig, n: int, current_only: bool, kind: str | None = None,
               fields: str | None = None) -> int:
    """`led current [N]`: the legacy tool's own `ledger_current` reading, exactly. `led --recent
    [N]`: the legacy tool additionally walked the RAW ledger (superseded rows included, visibly
    marked) -- no boundary route serves the raw table (every route reads a KERNEL VIEW, spec §5's
    "no truth of its own" applied to routes too; a raw-ledger route is out of THIS amendment's own
    scope). Rather than silently narrowing --recent to look like `current`, this rebase says so
    loudly on stderr and serves the SAME `/rows/current` reading. DISCLOSED NARROWING, permanent
    as of legacy-led-retirement (ledger row 1149/1150, legacy-led.tmpl deleted outright): the
    superseded-inclusive raw read this NOTE used to point at `./legacy/led --recent` for has no
    surviving recovery path at all -- named, not silently dropped.

    led-read-projection-flags (this brief, item 1): `kind`, when given, narrows to that ledger
    kind BEFORE the top-N selection (a caller asking for "the 5 most recent findings" wants five
    findings, not the findings within the 5 most recent rows of any kind) -- REFUSED against the
    live `GET /kinds` vocabulary (`_live_kind_vocab`) rather than silently matching nothing on a
    typo. `fields`, when given, switches the output from the plain `[id] kind: statement` line
    (unprojectable -- it is not JSON) to one JSON object per line, restricted to the requested
    fields (`_project_fields`)."""
    verb_label = "led current" if current_only else "led --recent"
    if not current_only:
        print("led --recent: NOTE -- this rebase's --recent reads /rows/current (in-force rows "
              "only, no raw-ledger route exists on the boundary, and no legacy recovery path "
              "survives legacy-led.tmpl's own retirement) -- the superseded-inclusive raw read "
              "is not available from any CLI in this repository anymore.", file=sys.stderr)
    rows = bcc.get_all_rows(cfg.base, "/rows/current", cursor="after_id")
    if kind is not None:
        live = _live_kind_vocab(cfg)
        if live is not None and kind not in live:
            print(f"{verb_label}: REFUSED -- unrecognized --kind {kind!r} (not a live member of "
                  f"ledger_kind_check's vocabulary; valid kinds: {', '.join(live)}).",
                  file=sys.stderr)
            return 4
        rows = [r for r in rows if r.get("kind") == kind]
    selected = sorted(rows, key=lambda r: -r["id"])[:n]
    if fields is not None:
        projected, err = _project_fields(selected, fields, verb_label)
        if err is not None:
            return err
        for r in projected:
            print(json.dumps(r, sort_keys=True))
        return 0
    for r in selected:
        print(f"[{r['id']}] {r['kind']}: {r.get('statement', '')}")
    return 0


def cmd_show(cfg: bcc.ServedConfig, row_id: int, fields: str | None = None) -> int:
    """led-read-projection-flags (this brief, item 1): `fields`, when given, restricts the
    printed key: value lines to the requested field names (REFUSED against this row's OWN key
    set on an unrecognized name -- `_project_fields`'s own discipline, applied here to a single
    row instead of a list) -- and, unlike the default all-fields listing, prints a REQUESTED
    field even when its value is None (the caller named it explicitly; silently omitting it would
    be indistinguishable from "not a column on this row", the exact false-empty this item bans)."""
    try:
        row = bcc.get_json(cfg.base, f"/rows/{row_id}")
    except bcc.BoundaryRefusal as e:
        if e.status == 404:
            print(f"led show: REFUSED -- no row {row_id}.", file=sys.stderr)
            print("  See 'led --recent [N]' or 'led current [N]' for ids that actually exist.", file=sys.stderr)
            return 1
        raise
    if fields is not None:
        projected, err = _project_fields([row], fields, "led show")
        if err is not None:
            return err
        for k in [f.strip() for f in fields.split(",") if f.strip()]:
            print(f"{k:28s}: {row.get(k)}")
        return 0
    for k, v in row.items():
        if v is not None:
            print(f"{k:28s}: {v}")
    return 0


