            print("led work startable: REFUSED -- requires kernel/lineage/s39-blocks-start.sql "
                  "applied to this project's schema (work_startable view not found -- this "
                  "world's kernel predates s39). Apply s39 as a maintainer act, or use 'led "
                  "work list' in the meantime.", file=sys.stderr)
