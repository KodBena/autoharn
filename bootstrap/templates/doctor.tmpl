#!/usr/bin/env python3
# autoharn-verb-desc: is this world set up right? one witnessed PASS/FAIL/SKIP report, read-only
"""doctor -- "is this world set up right?" (ledger rows 1147/1148, virgin-experience round).

WHY THIS EXISTS: row 1147's finding named the real gap plainly -- a newborn world was not
self-describing enough to keep a cheap orchestrator oriented, and the maintainer proposed two
fixes: a self-describing CLAUDE.md (see bootstrap/templates/CLAUDE.md.tmpl's own new opening
block) and a `doctor` verb answering the operator's actual question in one witnessed call,
rather than requiring several separate reads (deployment.json, a psql session, `./autoharn led`, ...)
before an orchestrator can say whether a world is healthy.

READ-ONLY, ALWAYS. This file issues no INSERT/UPDATE/DELETE and writes no file -- every check
below is a SELECT, an HTTP GET, or an `os.access`/subprocess exit-code read. It ONLY answers
"is this world set up right", never changes the answer.

EACH LINE IS PASS/FAIL/SKIP, ONE LINE, ONE DETAIL (house convention: distance-to-clean.tmpl's
own one-section-one-line shape, reused here across seven independent facts instead of one
composed debt count). SKIP is a DISTINCT, HONEST verdict from FAIL -- e.g. "no boundary_url
configured" is not a defect (a freshly-scaffolded world never auto-starts a boundary service;
the scaffold's own header comment for --boundary-url says so explicitly), so it must not read
as broken. Exit status reflects FAIL only: exit 0 iff zero FAIL lines (any number of SKIP lines
still exits 0 -- an honestly-reported not-applicable check is not the same as a defect); exit 1
iff at least one FAIL line. A downstream check that depends on an earlier FAILED check (e.g.
every DB-backed check once "database reachable" has failed) is printed as SKIP, not a second
FAIL for the same root cause -- one FAIL should not fan out into a wall of red for one problem.

Deployment resolution: byte-identical to distance-to-clean.tmpl's own module docstring section
of the same name -- this file executes IN PLACE out of the autoharn checkout (the "live verbs"
ruling, BACKLOG 2026-07-11), `PICKUP_DEPLOYMENT` is set by the scaffolded shim to the world's own
deployment.json, and `AUTOHARN` resolves from this file's own on-disk path (overridable).

Lazy imports banned (top-of-file only, per this project's inherited convention, gates/
no_lazy_imports.py). No bare types in new Python (ledger row 1105) -- every function signature
below carries its return-type annotation.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
AUTOHARN = Path(os.environ.get("AUTOHARN", str(HERE / ".." / ".."))).resolve()
DEPLOYMENT_PATH = Path(os.environ.get("PICKUP_DEPLOYMENT", str(HERE / "deployment.json")))
# The directory containing deployment.json IS this deployment's own root -- the same resolution
# distance-to-clean.tmpl and attest-doc.tmpl both use.
PROJECT_ROOT = DEPLOYMENT_PATH.parent

# Round-3 review ROOT CAUSE fix (discharges the standing row-1159 residual for this verb, the
# same treatment audit.tmpl got in round 2): intercept --help/-h HERE, before deployment.json is
# ever touched. Without this, main() called check_deployment() unconditionally -- argv was never
# consulted at all -- so a deployment-less checkout's `--help` produced the SAME shared
# "deployment record not found ... pickup, judge, and led alike" refusal every OTHER
# deployment-resolving verb produces, with no marker naming 'doctor' anywhere (a dispatch-parity
# hazard: a wrong-target dispatch landing on this verb would look identical to the real one).
# This is a real, side-effect-free usage line naming this verb, printed and exited BEFORE
# deployment_record is even imported.
if any(a in ("--help", "-h") for a in sys.argv[1:]):
    print(
        "usage: doctor\n"
        "\n"
        "doctor -- is this world set up right? One witnessed PASS/FAIL/SKIP line per fact:\n"
        "deployment.json parses, database reachable, schema+kern namespaces exist, lineage\n"
        "high-water/epoch, ./autoharn led answers a read query, boundary URL, principals registered,\n"
        "courier principal registered, world_identity populated.\n"
        "Read-only throughout -- issues no INSERT/UPDATE/DELETE and writes no file. Exit 0 iff\n"
        "zero FAIL lines (SKIP is a distinct, honest verdict, never a failure); exit 1 iff at\n"
        "least one FAIL line. Takes no arguments beyond --help/-h."
    )
    sys.exit(0)

sys.path.insert(0, str(AUTOHARN / "filing"))
sys.path.insert(0, str(AUTOHARN / "serving"))
try:
    import deployment_record  # noqa: E402  (filing/deployment_record.py, the ONE home for the shape)
    # serving/ensure_running.py's own `pid_is_boundary_service` -- round-4 review SEVERE-B item 4:
    # the boundary URL answering is not, by itself, proof this world's own pidfile/`autoharn
    # service stop` bookkeeping is consistent with it (an unrecorded winner, see that module's own
    # stale-pidfile-squat fix, can serve correctly while this world's tooling has no record of the
    # pid actually doing so) -- reused here rather than a second, drifting copy of the same
    # /proc/<pid>/cmdline identity check (ADR-0012 P1).
    import ensure_running  # noqa: E402
except ImportError as _e:
    print(f"doctor: cannot import autoharn's filing/deployment_record.py or "
          f"serving/ensure_running.py under AUTOHARN={AUTOHARN} ({_e.__class__.__name__}: {_e})",
          file=sys.stderr)
    print("        set AUTOHARN=/path/to/autoharn, or place a sibling checkout at ../autoharn", file=sys.stderr)
    sys.exit(2)

PASS = "PASS"
FAIL = "FAIL"
SKIP = "SKIP"


def _line(label: str, verdict: str, detail: str) -> str:
    return f"{label:<32} {verdict:<4} {detail}"


def _first_line(text: str) -> str:
    text = text.strip()
    return text.splitlines()[0] if text else "(no detail)"


def _psql(host: str, db: str, sql: str, binds: dict[str, str] | None = None,
          timeout: float = 10.0) -> subprocess.CompletedProcess:
    """SQL text always fed on stdin, never via -c (ADR-0012's 2026-07-18 interpreter-boundary
    amendment: psql's :'var'/:"var" bind interpolation is only performed for script/stdin input,
    silently inert under -c) -- same convention every other verb template in this project
    follows (distance-to-clean.tmpl, teardown-world.sh, new-project.sh)."""
    argv = ["psql", "-h", host, "-d", db, "-tA", "-v", "ON_ERROR_STOP=1"]
    for key, value in (binds or {}).items():
        argv += ["-v", f"{key}={value}"]
    return subprocess.run(argv, input=sql, capture_output=True, text=True, timeout=timeout)


def check_deployment() -> tuple[str, str, deployment_record.DeploymentRecord | None]:
    """Returns (line, verdict, dep-or-None)."""
    try:
        dep = deployment_record.load_deployment(DEPLOYMENT_PATH)
    except deployment_record.DeploymentError as e:
        return _line("deployment.json", FAIL, _first_line(str(e))), FAIL, None
    return _line("deployment.json", PASS, f"parsed ({DEPLOYMENT_PATH})"), PASS, dep


def check_db(dep: deployment_record.DeploymentRecord) -> tuple[str, str]:
    """Returns (line, verdict)."""
    try:
        r = _psql(dep.host, dep.db, "SELECT 1;")
    except (OSError, subprocess.TimeoutExpired) as e:
        return _line("database reachable", FAIL, f"{e.__class__.__name__}: {e}"), FAIL
    if r.returncode != 0:
        return _line("database reachable", FAIL, _first_line(r.stderr) or f"exit {r.returncode}"), FAIL
    return _line("database reachable", PASS, f"{dep.host}/{dep.db} (SELECT 1 ok)"), PASS


def check_namespaces(dep: deployment_record.DeploymentRecord) -> tuple[str, str]:
    r = _psql(dep.host, dep.db,
              "SELECT count(*) FROM pg_namespace WHERE nspname IN (:'schema', :'kern');",
              {"schema": dep.schema, "kern": dep.kern})
    if r.returncode != 0:
        return _line("schema + kern schema exist", FAIL, _first_line(r.stderr) or f"exit {r.returncode}"), FAIL
    count = r.stdout.strip()
    if count == "2":
        return _line("schema + kern schema exist", PASS,
                     f"'{dep.schema}' and '{dep.kern}' both present"), PASS
    return _line("schema + kern schema exist", FAIL,
                 f"expected 2 namespaces ('{dep.schema}', '{dep.kern}'), found {count or '0'}"), FAIL


def check_lineage(dep: deployment_record.DeploymentRecord) -> tuple[str, str]:
    r = _psql(dep.host, dep.db, 'SELECT max_id FROM :"kern".chain_high_water;', {"kern": dep.kern})
    if r.returncode != 0:
        if "does not exist" in r.stderr:
            return _line("lineage high-water/epoch", SKIP,
                         "no kern.chain_high_water (this world's kernel predates "
                         "kernel/lineage/s27-chain-high-water.sql)"), SKIP
        return _line("lineage high-water/epoch", FAIL, _first_line(r.stderr) or f"exit {r.returncode}"), FAIL
    max_id = r.stdout.strip()
    try:
        max_id_ok = int(max_id) >= 0
    except ValueError:
        max_id_ok = False
    if not max_id_ok:
        return _line("lineage high-water/epoch", FAIL,
                     f"kern.chain_high_water.max_id read back as {max_id!r} "
                     f"(not a sane non-negative integer)"), FAIL
    epoch_detail = ""
    r2 = _psql(dep.host, dep.db, 'SELECT epoch FROM :"kern".migration_epoch;', {"kern": dep.kern})
    if r2.returncode == 0 and r2.stdout.strip():
        epoch_detail = f", migration_epoch.epoch={r2.stdout.strip()}"
    return _line("lineage high-water/epoch", PASS, f"chain_high_water.max_id={max_id}{epoch_detail}"), PASS


def check_led(dep: deployment_record.DeploymentRecord) -> tuple[str, str]:
    """legacy-led-retirement inventory pass (ledger row 1149/1150; integration-merge
    reconciliation task A, 2026-07-23): this check used to PREFER `./legacy/led` (the direct-
    psql original) whenever no boundary was configured, on the theory that a freshly-scaffolded,
    boundary-less world was the common case and `./legacy/led` was the honestly-"working" verb
    in that mode. That theory is now FALSE -- `bootstrap/templates/legacy-led.tmpl` no longer
    exists in this repository, and `new-project.sh` now scaffolds `<dest>/legacy/led` as a
    one-line TEACHING-REFUSAL STUB (see new-project.sh's own "legacy/led: RETIRED" heredoc) that
    always exits non-zero -- preferring it here would make doctor report FAIL against the stub's
    own refusal text, never the real fact this check exists to answer. Post-retirement the
    boundary is MANDATORY at every birth (no decline option, `tools/setup_tui/steps_boundary.py`
    fields() docstring) -- there is exactly one lawful `led` per world now (`runner.
    served_led_path`'s own docstring, the same fact this world's served `./led` shim enforces),
    so this check drives ONLY the served `./led`, unconditionally: PASS iff it answers a real
    read; FAIL -- never SKIP, never a legacy fallback -- with the concrete start command as
    teaching, whether the boundary was never configured at all (no boundary-multiplex.toml) or
    was configured but is not currently reachable (`check_boundary` below reports the SAME
    unreachable fact independently; this FAIL is not contingent on that check having run)."""
    # §6 amendment (2026-07-26, rows 1357/1365/1366/1367): a world no longer has a standalone
    # `led` shim file -- `./autoharn led ...` is the one dispatcher every verb routes through
    # now (design/FABLE-AUTOHARN-UMBRELLA-CLI-SPEC.md §6 amendment). This check used to drive
    # `PROJECT_ROOT / "led"` directly; that file no longer exists on a freshly-scaffolded world,
    # so driving it unconditionally would FAIL every newborn world at birth -- exactly the kind
    # of hazard this migration must not leave behind. Drives the world's own `./autoharn`
    # dispatcher with `led --recent 1` instead; same live read, same PASS/FAIL shape.
    dispatcher_bin = PROJECT_ROOT / "autoharn"
    toml_path = PROJECT_ROOT / "boundary-multiplex.toml"
    if not dep.boundary_url:
        if toml_path.is_file():
            teach = (f"boundary configured but not running -- start it: (cd {AUTOHARN} && "
                     f"python3 -m serving.boundary_service --config {toml_path} --port <PORT>) "
                     f"then re-run doctor (the port is whichever one this world's own "
                     f"boundary-multiplex.toml/deployment.json boundary_url names)")
        else:
            teach = (f"boundary never configured for this world -- run the setup wizard against "
                     f"it: (cd {AUTOHARN} && python3 tools/setup_tui/app.py {PROJECT_ROOT}), "
                     f"select Boundary in the tree, and commit -- there is no legacy/led fallback "
                     f"to reach for (design/FABLE-LEGACY-LED-RETIREMENT-SPEC.md)")
        return _line("./autoharn led answers a read query", FAIL,
                     f"boundary_url absent from deployment.json -- {teach}"), FAIL
    if not (dispatcher_bin.is_file() and os.access(dispatcher_bin, os.X_OK)):
        return _line("./autoharn led answers a read query", FAIL,
                     f"no executable ./autoharn dispatcher at {PROJECT_ROOT}"), FAIL
    try:
        r = subprocess.run([str(dispatcher_bin), "led", "--recent", "1"], cwd=PROJECT_ROOT,
                           capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired) as e:
        return _line("./autoharn led answers a read query", FAIL, f"{e.__class__.__name__}: {e}"), FAIL
    if r.returncode != 0:
        detail = _first_line(r.stderr) or _first_line(r.stdout) or f"exit {r.returncode}"
        teach = (f"start the boundary service: (cd {AUTOHARN} && python3 -m "
                 f"serving.boundary_service --config {toml_path} --port <PORT>) then re-run "
                 f"doctor -- the served ./autoharn led dispatch refuses every query while the "
                 f"boundary it depends on is down (design/FABLE-BOUNDARY-MULTIPLEX-AND-CLI-"
                 f"REBASE-SPEC.md §5)")
        return _line("./autoharn led answers a read query", FAIL, f"(./autoharn led) {detail} -- {teach}"), FAIL
    return _line("./autoharn led answers a read query", PASS, f"./autoharn led --recent 1 exited 0"), PASS


def _boundary_pidfile_consistency_note(dep: deployment_record.DeploymentRecord) -> str:
    """Round-4 review SEVERE-B item 4: the boundary URL answering does not, by itself, prove this
    world's own pidfile bookkeeping (the thing `autoharn service stop` relies on) names the
    process actually serving it -- an unrecorded winner (a stale-pidfile squat this tool's own
    spawn lost to, or an operator-started process this tool never tracked) can serve correctly
    while remaining unstoppable via the tracked path. PASS-worthy consistency (pidfile pid alive,
    IS a serving.boundary_service for this world's own toml) gets a quiet confirmation clause;
    everything else (pidfile missing, dead, or naming an unrelated process) gets the taught
    recovery, never a silent gap."""
    toml_path = PROJECT_ROOT / "boundary-multiplex.toml"
    pidfile = PROJECT_ROOT / ".autoharn-service.pid"
    pid: int | None = None
    if pidfile.is_file():
        try:
            pid = int(pidfile.read_text(encoding="utf-8").strip())
        except (OSError, ValueError):
            pid = None
    if pid is not None and ensure_running.pid_is_boundary_service(pid, toml_path):
        return f"; pidfile ({pidfile}) names live pid {pid}, consistent"
    return (f" -- WARNING: {pidfile} does not name a live serving.boundary_service process for "
            f"this world's own {toml_path} (missing, dead pid, or PID REUSE handed that pid to an "
            f"unrelated process) -- this may be an UNRECORDED winner (a stale-pidfile squat, or a "
            f"process started outside this tool's own tracking). 'autoharn service stop' has no "
            f"record of it and will refuse rather than guess. Find the real pid via "
            f"{PROJECT_ROOT / 'service.log'} or `ss -ltnp | grep :<port>` (the port "
            f"{dep.boundary_url!r} names) before assuming it can be stopped through this tool")


def check_boundary(dep: deployment_record.DeploymentRecord) -> tuple[str, str]:
    if not dep.boundary_url:
        return _line("boundary URL", SKIP,
                     "not configured (boundary_url absent from deployment.json -- the scaffold "
                     "never auto-starts a boundary process; standing one up is a separate "
                     "operator act)"), SKIP
    try:
        req = urllib.request.Request(dep.boundary_url, method="GET")
        with urllib.request.urlopen(req, timeout=3) as resp:
            return _line("boundary URL", PASS,
                         f"{dep.boundary_url} responded HTTP {resp.status}"
                         f"{_boundary_pidfile_consistency_note(dep)}"), PASS
    except urllib.error.HTTPError as e:
        # Any HTTP response at all -- even a 4xx/5xx -- means something is actually listening;
        # honest and not the same failure mode as "nothing answered".
        return _line("boundary URL", PASS,
                     f"{dep.boundary_url} responded HTTP {e.code}"
                     f"{_boundary_pidfile_consistency_note(dep)}"), PASS
    except (urllib.error.URLError, OSError, TimeoutError) as e:
        return _line("boundary URL", FAIL,
                     f"{dep.boundary_url} unreachable ({e.__class__.__name__}: {e})"), FAIL


def check_principals(dep: deployment_record.DeploymentRecord) -> tuple[str, str]:
    r = _psql(dep.host, dep.db, 'SELECT count(*) FROM :"kern".principal;', {"kern": dep.kern})
    if r.returncode != 0:
        if "does not exist" in r.stderr:
            return _line("principals registered", SKIP,
                         f"no {dep.kern}.principal (kernel lineage not applied to this world)"), SKIP
        return _line("principals registered", FAIL, _first_line(r.stderr) or f"exit {r.returncode}"), FAIL
    count = r.stdout.strip()
    return _line("principals registered", PASS, f"{count or '0'} row(s) in {dep.kern}.principal"), PASS


def check_courier_registered(dep: deployment_record.DeploymentRecord) -> tuple[str, str]:
    """work item birth-standing-steps-scaffold: the `courier` principal is now a birth act
    (bootstrap/new-project.sh's s58 courier birth act, design/FABLE-MISSIVES-KERNEL-SPEC.md §2.6)
    for every world whose kernel lineage includes s58-missive-substrate.sql -- witnessed missing
    at the experience4 birth until the first courier pull refused (autoharn3 row 122's by-hand
    fix). A world with s58 applied but no 'courier' row is the same class of gap, caught here
    rather than at the first courier pull."""
    r = _psql(dep.host, dep.db, "SELECT count(*) FROM :\"kern\".principal WHERE name = 'courier';",
              {"kern": dep.kern})
    if r.returncode != 0:
        if "does not exist" in r.stderr:
            return _line("courier principal registered", SKIP,
                         f"no {dep.kern}.principal (kernel lineage not applied to this world)"), SKIP
        return _line("courier principal registered", FAIL, _first_line(r.stderr) or f"exit {r.returncode}"), FAIL
    count = r.stdout.strip()
    r2 = _psql(dep.host, dep.db, 'SELECT count(*) FROM :"kern".world_identity;', {"kern": dep.kern})
    if r2.returncode != 0 and "does not exist" in r2.stderr and count in ("", "0"):
        return _line("courier principal registered", SKIP,
                     f"no {dep.kern}.world_identity (this world's kernel predates "
                     f"kernel/lineage/s58-missive-substrate.sql -- courier has no scope trigger "
                     f"to bind to here)"), SKIP
    if count not in ("", "0"):
        return _line("courier principal registered", PASS, f"registered ({dep.kern}.principal)"), PASS
    # Fix-round correction (reviewer-refuted finding on the first cut of this check, commit
    # 1eaee52): the ORIGINAL teach-text named `./autoharn led register-principal ...` as the fix
    # -- but that verb is a rebased, SERVED shim (serving/boundary_cli_client.py's
    # load_served_config REFUSES loudly whenever deployment.json lacks boundary_url/
    # boundary_deployment) and its own suggested escape, `./legacy/led`, is a retired teaching-
    # refusal stub (bootstrap/new-project.sh's "legacy/led: RETIRED" heredoc) that just re-
    # refuses pointing back at the SAME dead end -- reproduced verbatim by a fresh-context
    # reviewer on exactly the class of world most likely to show this FAIL (freshly-birthed or
    # interrupted, no boundary configured yet). The PRIMARY fix below is now the raw,
    # owner-connection `kernel.registration_write` call -- byte-identical in shape and purpose
    # text to the one `bootstrap/new-project.sh`'s own s58 courier birth act makes (§2.6) -- which
    # needs no boundary at all (the same "owner connection" posture the world_identity fix
    # immediately below already uses, and for the same reason: this call bypasses the granted
    # role's own REVOKE/GRANT surface, so it works whether or not a boundary is served). The
    # served CLI path is named second, as the alternative once boundary_url/boundary_deployment
    # are configured.
    return _line("courier principal registered", FAIL,
                 f"no 'courier' principal in {dep.kern}.principal -- every missive receipt this "
                 f"world pulls needs this identity to record arrivals as (design/"
                 f"FABLE-MISSIVES-KERNEL-SPEC.md §2.6). Fix (owner connection -- works with no "
                 f"boundary configured, the same kernel.registration_write call this world's own "
                 f"birth act makes): psql -h {dep.host} -d {dep.db} -v ON_ERROR_STOP=1 -c "
                 f"\"SELECT * FROM {dep.kern}.registration_write(jsonb_build_object("
                 f"'name','courier','agent_class','tool','purpose','Records cross-world missive "
                 f"arrivals pulled over the boundary service -- and can write nothing else "
                 f"(kernel-scoped: validate_missive_courier_scope, s58; consult §4.3, Q3 ratified "
                 f"row 1157). Never a deciding identity.','statement','principal ''courier'' "
                 f"registered (class tool) -- doctor teach-text recovery, registrar: author',"
                 f"'actor',(SELECT id FROM {dep.kern}.principal WHERE name = 'author')));\" -- "
                 f"or, once this world's deployment.json carries boundary_url and "
                 f"boundary_deployment (a served boundary), the equivalent served path: "
                 f"./autoharn led register-principal courier tool --purpose \"Records cross-world "
                 f"missive arrivals pulled over the boundary service -- and can write nothing "
                 f"else (kernel-scoped: validate_missive_courier_scope, s58; consult §4.3, Q3 "
                 f"ratified row 1157). Never a deciding identity.\""), FAIL


def check_world_identity(dep: deployment_record.DeploymentRecord) -> tuple[str, str]:
    """work item birth-standing-steps-scaffold: kernel.world_identity is now seeded at birth
    (bootstrap/new-project.sh, design/FABLE-MISSIVES-KERNEL-SPEC.md §2.1) for every world whose
    kernel lineage includes s58-missive-substrate.sql -- an empty table makes
    validate_missive_identity abort every missive write loudly (fail-safe by the kernel's own
    design), but the autoharn3 cutover had to populate the row by hand; this check catches the
    gap before the first missive write hits it."""
    r = _psql(dep.host, dep.db, 'SELECT world_name FROM :"kern".world_identity;', {"kern": dep.kern})
    if r.returncode != 0:
        if "does not exist" in r.stderr:
            return _line("world_identity populated", SKIP,
                         f"no {dep.kern}.world_identity (this world's kernel predates "
                         f"kernel/lineage/s58-missive-substrate.sql)"), SKIP
        return _line("world_identity populated", FAIL, _first_line(r.stderr) or f"exit {r.returncode}"), FAIL
    world_name = r.stdout.strip()
    if world_name:
        return _line("world_identity populated", PASS, f"world_name='{world_name}'"), PASS
    return _line("world_identity populated", FAIL,
                 f"{dep.kern}.world_identity has no row -- every missive write (send/receive/"
                 f"dispose) will refuse loudly until this is populated (design/"
                 f"FABLE-MISSIVES-KERNEL-SPEC.md §2.1). Fix (owner connection -- the granted role "
                 f"'{dep.role}' holds no INSERT here by design, s58 §2.1's own grants): psql -h "
                 f"{dep.host} -d {dep.db} -v ON_ERROR_STOP=1 -c \"INSERT INTO {dep.kern}."
                 f"world_identity (world_name) VALUES ('<this-world's-own-name>');\""), FAIL


def main() -> int:
    print("### doctor -- is this world set up right?")
    print(f"    ({PROJECT_ROOT})")
    print()

    verdicts: list[str] = []

    dep_line, dep_verdict, dep = check_deployment()
    print(dep_line)
    verdicts.append(dep_verdict)

    if dep is None:
        skip_reason = "deployment.json did not parse (see line above)"
        for label in ("database reachable", "schema + kern schema exist",
                      "lineage high-water/epoch", "./autoharn led answers a read query",
                      "boundary URL", "principals registered", "courier principal registered",
                      "world_identity populated"):
            print(_line(label, SKIP, skip_reason))
            verdicts.append(SKIP)
        print()
        fail_count = verdicts.count(FAIL)
        print(f"TOTAL: {fail_count} FAIL, {verdicts.count(PASS)} PASS, {verdicts.count(SKIP)} SKIP")
        return 1

    db_line, db_verdict = check_db(dep)
    print(db_line)
    verdicts.append(db_verdict)

    if db_verdict == PASS:
        for line, verdict in (check_namespaces(dep), check_lineage(dep), check_principals(dep),
                               check_courier_registered(dep), check_world_identity(dep)):
            print(line)
            verdicts.append(verdict)
    else:
        skip_reason = "database unreachable (see line above)"
        for label in ("schema + kern schema exist", "lineage high-water/epoch", "principals registered",
                      "courier principal registered", "world_identity populated"):
            print(_line(label, SKIP, skip_reason))
            verdicts.append(SKIP)

    led_line, led_verdict = check_led(dep)
    print(led_line)
    verdicts.append(led_verdict)

    boundary_line, boundary_verdict = check_boundary(dep)
    print(boundary_line)
    verdicts.append(boundary_verdict)

    print()
    fail_count = verdicts.count(FAIL)
    print(f"TOTAL: {fail_count} FAIL, {verdicts.count(PASS)} PASS, {verdicts.count(SKIP)} SKIP"
          + ("  (0 FAIL = healthy)" if fail_count == 0 else ""))
    return 0 if fail_count == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
